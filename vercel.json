{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npx next build",
  "installCommand": "npm install",
  "functions": {
    "src/app/**/*.{ts,tsx}": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "*/4 * * * *"
    },
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ]
}
