// ====================================================================
// SaaS Plateforme de Gestion Scolaire — Schéma Prisma complet
// Couvre: SaaS, fondations, élèves, personnel, pédagogique (chiffré
// + compétences), présences, vie scolaire, finances, RH, services,
// salles, examens officiels, RDV, sécurité physique, communication,
// audit, conformité mineurs.
// ====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================================
// PARTIE A — COUCHE SaaS (multi-écoles, plans, abonnements, factures)
// ====================================================================

model Ecole {
  id            String    @id @default(cuid())
  nom           String
  slug          String    @unique
  pays          String    @default("SN")
  devise        String    @default("XOF")
  fuseauHoraire String    @default("Africa/Dakar")
  logoUrl       String?
  dateCreation  DateTime  @default(now())
  statut        String    @default("essai") // essai/actif/suspendu/resilie
  deletedAt     DateTime?

  abonnements                Abonnement[]
  facturesSaas               FactureSaas[]
  anneesScolaires            AnneeScolaire[]
  cycles                     Cycle[]
  matieres                   Matiere[]
  salles                     Salle[]
  manuels                    ManuelScolaire[]
  calendrier                 CalendrierScolaire[]
  eleves                     Eleve[]
  personnels                 Personnel[]
  utilisateurs               Utilisateur[]
  roles                      Role[]
  modesMessage               ModeleMessage[]
  notifications              Notification[]
  permissions                Permission[]
  frais                      Frais[]
  paiements                  Paiement[]
  depenses                   Depense[]
  articlesStock              StockArticle[]
  examensOfficiels           ExamenOfficiel[]
  cantines                   CantineInscription[]
  transports                 TransportInscription[]
  lignesTransport            TransportLigne[]
  biblioLivres               BiblioLivre[]
  visiteurs                  Visiteur[]
  plans                      PlanTarifaire?              @relation("EcolePlanCourant", fields: [planCourantId], references: [id])
  planCourantId              String?
  tickets                    Ticket[]
  signalementMineurs         SignalementMineur[]
  verificationAntecedents    VerificationAntecedents[]
  habilitationPenales        HabilitationPenale[]
  bulletinPaies              BulletinPaie[]
  variablePaies              VariablePaie[]
  offreEmplois               OffreEmploi[]
  stages                     Stage[]
  soldeConges                SoldeConge[]
  candidatureAdmissions      CandidatureAdmission[]
  emploiTemps                EmploiTemps[]
  devoirs                    Devoir[]
  cahierTextes               CahierTexte[]
  conseilClasses             ConseilClasse[]
  dispenses                  Dispense[]
  justificationAbsences      JustificationAbsence[]
  budgets                    Budget[]
  compteComptables           CompteComptable[]
  journalComptables          JournalComptable[]
  ecritureComptables         EcritureComptable[]
  fournisseurs               Fournisseur[]
  commandeFournisseurs       CommandeFournisseur[]
  factureFournisseurs        FactureFournisseur[]
  paiementFournisseurs       PaiementFournisseur[]
  avoirEcoles                AvoirEcole[]
  conversations              Conversation[]
  annonces                   Annonce[]
  smsLogs                    SmsLog[]
  apiTokens                  ApiToken[]
  webhookSortants            WebhookSortant[]
  consentementImages         ConsentementImage[]
  consentementCommunications ConsentementCommunication[]
  registreTraitements        RegistreTraitement[]
  domainePersonnalises       DomainePersonnalise[]
  themeEcole                 ThemeEcole?
  featureFlagEcoles          FeatureFlagEcole[]
  quotaUsages                QuotaUsage[]
  avoirSaas                  AvoirSaas[]
  planAccompagnements        PlanAccompagnement[]
  templateDocuments          TemplateDocument[]
  documentGeneres            DocumentGenere[]
  rapportSauvegardes         RapportSauvegarde[]
  batiments                  Batiment[]
  fichesSante                FicheSante[]
  passagesInfirmerie         PassageInfirmerie[]
  vaccinations               Vaccination[]
  // Back-relations (F17 — intégrité référentielle réelle)
  classes                    Classe[]
  periodes                   Periode[]
  programmes                 Programme[]
  evaluations                Evaluation[]
  competences                Competence[]
  parentTuteurs              ParentTuteur[]
  auditLogs                  AuditLog[]
  reglesCalcul               RegleCalculMoyenne[] // F17
  sauvegardes                Sauvegarde[]
  fichiers                   StockageFichier[]
  emailLogs                  EmailLog[]
  configurationPaie          ConfigurationPaie?
  accesUtilisateurs          UtilisateurEcole[]
  cantineMenus               CantineMenu[]
  cantinePresences           CantinePresence[]
  feuillesRoute              FeuilleRoute[]
  pointagesPersonnel         PointagePersonnel[]
  activites                  Activite[]
  garderieInscriptions       GarderieInscription[]
  garderieSessions           GarderieSession[]
  lignesReleve               LigneReleve[]
}

model PlanTarifaire {
  id              String   @id @default(cuid())
  nom             String
  prixMensuel     Int // centimes (F16 — plus de Float sur l'argent)
  prixAnnuel      Int // centimes
  devise          String   @default("XOF")
  limiteEleves    Int?
  modulesInclus   String   @default("[]") // JSON array as text
  dureeEssaiJours Int      @default(14)
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  abonnements  Abonnement[]
  ecoleCourant Ecole[]      @relation("EcolePlanCourant")
}

model Abonnement {
  id              String        @id @default(cuid())
  ecoleId         String
  ecole           Ecole         @relation(fields: [ecoleId], references: [id])
  planId          String
  plan            PlanTarifaire @relation(fields: [planId], references: [id])
  dateDebut       DateTime      @default(now())
  dateFin         DateTime?
  statut          String        @default("essai") // essai/actif/suspendu/resilie
  modeFacturation String        @default("mensuel") // mensuel/annuel
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  factures FactureSaas[]
}

model FactureSaas {
  id           String     @id @default(cuid())
  ecoleId      String
  ecole        Ecole      @relation(fields: [ecoleId], references: [id])
  abonnementId String
  abonnement   Abonnement @relation(fields: [abonnementId], references: [id])
  periode      String // "2026-08"
  montant      Int // centimes
  devise       String
  statut       String     @default("impayee") // payee/impayee/en_retard
  modePaiement String?
  dateEmission DateTime   @default(now())
  datePaiement DateTime?

  // F19 — idempotence de la facturation mensuelle
  @@unique([ecoleId, abonnementId, periode])
}

// ====================================================================
// PARTIE B — FONDATIONS ACADEMIQUES
// ====================================================================

model AnneeScolaire {
  id        String   @id @default(cuid())
  ecoleId   String
  ecole     Ecole    @relation(fields: [ecoleId], references: [id])
  libelle   String // "2026-2027"
  dateDebut DateTime
  dateFin   DateTime
  active    Boolean  @default(false)

  periodes            Periode[]
  classes             Classe[]
  programmes          Programme[]
  calendrier          CalendrierScolaire[]
  listesFourn         ListeFourniture[]
  budgets             Budget[]
  // F17 — back-relations
  frais               Frais[]
  examens             ExamenOfficiel[]
  inscriptionsCantine CantineInscription[]

  @@unique([ecoleId, libelle])
}

model Cycle {
  id             String @id @default(cuid())
  ecoleId        String
  ecole          Ecole  @relation(fields: [ecoleId], references: [id])
  code           String // MAT/PRIM/COLL/LYC
  libelle        String
  ordre          Int
  modeEvaluation String @default("chiffre") // chiffre/competences

  sections     Section[]
  competences  Competence[]
  reglesCalcul RegleCalculMoyenne[]

  @@unique([ecoleId, code])
}

model Section {
  id      String @id @default(cuid())
  cycleId String
  cycle   Cycle  @relation(fields: [cycleId], references: [id])
  code    String
  libelle String

  niveaux Niveau[]
}

model Niveau {
  id        String  @id @default(cuid())
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])
  code      String
  libelle   String
  ordre     Int

  classes               Classe[]
  programmes            Programme[]
  frais                 Frais[]
  manuels               ManuelScolaire[]
  listesFourn           ListeFourniture[]
  examens               ExamenOfficiel[]
  candidatureAdmissions CandidatureAdmission[]
}

model Classe {
  id                    String        @id @default(cuid())
  niveauId              String
  niveau                Niveau        @relation(fields: [niveauId], references: [id])
  anneeScolaireId       String
  anneeScolaire         AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  ecoleId               String
  ecole                 Ecole         @relation(fields: [ecoleId], references: [id]) // F17
  code                  String
  libelle               String
  capaciteMax           Int?
  enseignantPrincipalId String?

  eleves                Eleve[]
  seances               Seance[]
  evaluations           Evaluation[]
  historiqueClasses     EleveHistoriqueClasse[]
  avancements           AvancementProgramme[]
  reunionsCollectives   ReunionCollective[]
  inscriptionsCantine   CantineInscription[]
  inscriptionsTransport TransportInscription[]
  emploiTemps           EmploiTemps[]
  devoirs               Devoir[]
  cahierTextes          CahierTexte[]
  conseilClasses        ConseilClasse[]
  bulletins             Bulletin[] // F17
  creneauHebdos         CreneauHebdo[] // F17
  personnelRoles        PersonnelRole[] // F17

  @@unique([ecoleId, code, anneeScolaireId])
  @@index([ecoleId, anneeScolaireId]) // F18
}

// ====================================================================
// PARTIE B — UTILISATEURS, RÔLES, PERMISSIONS (RBAC)
// ====================================================================

model Utilisateur {
  id                  String    @id @default(cuid())
  ecoleId             String?
  ecole               Ecole?    @relation(fields: [ecoleId], references: [id])
  email               String
  motDePasseHash      String
  telephone           String?
  nom                 String
  prenom              String
  type                String // parent/personnel/eleve/super_admin
  actif               Boolean   @default(true)
  twofaActive         Boolean   @default(false)
  derniereConnexion   DateTime?
  tentativesEchouees  Int       @default(0)
  verrouilleJusqua    DateTime?
  consentementPortail Boolean   @default(false)
  consentementDate    DateTime?
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?

  personnel     Personnel?
  parent        ParentTuteur?
  eleve         Eleve?
  roles         UtilisateurRole[]
  auditLogs     AuditLog[]
  notifications Notification[]

  // F17 — sécurité : cycles de vie liés au compte
  sessions                  SessionUtilisateur[]  @relation("SessionUtilisateurUser")
  tentativesConnexion       TentativeConnexion[]  @relation("TentativeConnexionUser")
  twoFactorMethods          TwoFactorMethod[]
  twoFactorBackupCodes      TwoFactorBackupCode[]
  jetonsAuth                JetonAuth[]
  pushTokens                PushToken[]           @relation("PushTokenUser") // F20
  // F17 — traçabilité des acteurs (SetNull : l'acteur parti n'efface pas l'historique)
  paiementsEncaisses        Paiement[]            @relation("PaiementEncaissePar")
  paiementsAnnules          Paiement[]            @relation("PaiementAnnulePar")
  notesSaisies              Note[]                @relation("NoteSaisiePar")
  presencesSaisies          Presence[]            @relation("PresenceSaisiePar")
  bulletinsCrees            Bulletin[]            @relation("BulletinCreePar")
  bulletinsValidesPp        Bulletin[]            @relation("BulletinValidePpPar")
  bulletinsValidesDirection Bulletin[]            @relation("BulletinValideDirectionPar")
  incidentsDeclares         Incident[]            @relation("IncidentDeclarePar")
  sanctionsDecidees         Sanction[]            @relation("SanctionDecidePar")
  sortiesValidees           SortieAnticipee[]     @relation("SortieValidePar")
  autorisationsValidees     AutorisationSortie[]  @relation("AutorisationValidePar")
  congesTraites             Conge[]               @relation("CongeTraitePar")
  depensesValidees          Depense[]             @relation("DepenseValideePar")
  mouvementsStockEffectues  MouvementStock[]      @relation("MouvementStockEffectuePar")
  amenagementsValides       Amenagement[]         @relation("AmenagementValidePar")
  depensesCreees            Depense[]             @relation("DepenseCreePar")
  accesEcoles               UtilisateurEcole[]    @relation("UtilisateurEcoleUser")

  @@unique([ecoleId, email])
}

model Role {
  id          String  @id @default(cuid())
  ecoleId     String?
  ecole       Ecole?  @relation(fields: [ecoleId], references: [id])
  code        String // direction/enseignant/parent/eleve/comptabilite/secretariat/surveillant
  libelle     String
  twofaRequis Boolean @default(false)

  permissions    RolePermission[]
  utilisateurs   UtilisateurRole[]
  personnelRoles PersonnelRole[]
}

model Permission {
  id      String @id @default(cuid())
  code    String @unique
  libelle String
  module  String

  roles  RolePermission[]
  ecoles Ecole[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UtilisateurRole {
  utilisateurId String
  role          Role        @relation(fields: [roleId], references: [id])
  roleId        String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  dateDebut     DateTime    @default(now())
  dateFin       DateTime?

  @@id([utilisateurId, roleId])
}

// ====================================================================
// PARTIE B — ÉLÈVES + INCLUSION (C.2)
// ====================================================================

model Eleve {
  id                           String       @id @default(cuid())
  ecoleId                      String
  ecole                        Ecole        @relation(fields: [ecoleId], references: [id])
  matricule                    String?
  nom                          String
  prenom                       String
  dateNaissance                DateTime
  lieuNaissance                String?
  sexe                         String?
  photoUrl                     String?
  statut                       String       @default("actif") // actif/diplome/transfere/exclu
  dateInscription              DateTime     @default(now())
  dateSortie                   DateTime?
  motifSortie                  String?
  classeActuelleId             String?
  classeActuelle               Classe?      @relation(fields: [classeActuelleId], references: [id])
  adresse                      String? // JSON
  allergies                    String?
  conditionMedicale            String?
  contactUrgence               String? // JSON
  consentementPortailEleve     Boolean      @default(false)
  consentementPortailEleveDate DateTime?
  consentementPhotoInterne     Boolean      @default(false)
  consentementPhotoExterne     Boolean      @default(false)
  utilisateurId                String?      @unique
  utilisateur                  Utilisateur? @relation(fields: [utilisateurId], references: [id])
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  deletedAt                    DateTime?

  parents                    EleveParent[]
  documents                  DocumentEleve[]
  historiqueClasses          EleveHistoriqueClasse[]
  besoinsSpecifiques         BesoinSpecifique[]
  amenagements               Amenagement[]
  presences                  Presence[]
  notes                      Note[]
  evaluationsCompetence      EvaluationCompetence[]
  bulletins                  Bulletin[]
  echeances                  EcheanceFrais[]
  paiements                  Paiement[]
  incidents                  Incident[]
  attributionsManuel         AttributionManuel[]
  autorisationsSortie        AutorisationSortie[]
  sortiesAnticipees          SortieAnticipee[]
  inscriptionsCantine        CantineInscription[]
  inscriptionsTransport      TransportInscription[]
  pretsBiblio                BiblioPret[]
  rdvs                       Rdv[]
  inscriptionsExamenOfficiel InscriptionExamenOfficiel[]
  signalementMineurs         SignalementMineur[]
  stages                     Stage[]
  renduDevoirs               RenduDevoir[]
  deliberationConseils       DeliberationConseil[]
  dispenses                  Dispense[]
  justificationAbsences      JustificationAbsence[]
  consentementImages         ConsentementImage[]
  planAccompagnements        PlanAccompagnement[]
  ficheSante                 FicheSante?
  passagesInfirmerie         PassageInfirmerie[]
  vaccinations               Vaccination[]
  cantinePresences           CantinePresence[] // O1
  garderieInscription        GarderieInscription? // M8
  garderieSessions           GarderieSession[] // M8
  activiteParticipations     ActiviteParticipant[] // M7

  @@unique([ecoleId, matricule])
  @@index([ecoleId, nom]) // F18
}

model ParentTuteur {
  id            String       @id @default(cuid())
  ecoleId       String
  ecole         Ecole        @relation(fields: [ecoleId], references: [id]) // F17
  utilisateurId String?      @unique
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])
  nom           String
  prenom        String
  telephone     String?
  email         String?
  profession    String?
  lienAvecEleve String // pere/mere/tuteur_legal

  eleves    EleveParent[]
  paiements Paiement[]
  rdvs      Rdv[]
}

model EleveParent {
  eleveId           String
  eleve             Eleve        @relation(fields: [eleveId], references: [id])
  parentId          String
  parent            ParentTuteur @relation(fields: [parentId], references: [id])
  autoriteParentale Boolean      @default(true)

  @@id([eleveId, parentId])
}

model EleveHistoriqueClasse {
  id         String    @id @default(cuid())
  eleveId    String
  eleve      Eleve     @relation(fields: [eleveId], references: [id])
  classeId   String
  classe     Classe    @relation(fields: [classeId], references: [id])
  dateEntree DateTime
  dateSortie DateTime?
  motif      String?
}

model DocumentEleve {
  id           String   @id @default(cuid())
  eleveId      String
  eleve        Eleve    @relation(fields: [eleveId], references: [id])
  type         String // acte_naissance/cv/certificat_medical/diplome
  fichierUrl   String
  confidentiel Boolean  @default(false)
  dateAjout    DateTime @default(now())
  ajouteParId  String
}

model BesoinSpecifique {
  id                      String    @id @default(cuid())
  eleveId                 String
  eleve                   Eleve     @relation(fields: [eleveId], references: [id])
  type                    String // trouble_apprentissage/handicap_moteur/deficit_visuel/auditif/autre
  description             String
  dateDiagnostic          DateTime?
  documentJustificatifUrl String?
  confidentiel            Boolean   @default(true)
  creeLe                  DateTime  @default(now())

  amenagements Amenagement[]
}

model Amenagement {
  id                 String            @id @default(cuid())
  eleveId            String
  eleve              Eleve             @relation(fields: [eleveId], references: [id])
  besoinSpecifiqueId String?
  besoinSpecifique   BesoinSpecifique? @relation(fields: [besoinSpecifiqueId], references: [id])
  typeAmenagement    String // tiers_temps/AVS/materiel_adapte/amenagement_pedagogique
  description        String
  dateDebut          DateTime
  dateFin            DateTime?
  valideParId        String?
  validePar          Utilisateur?      @relation("AmenagementValidePar", fields: [valideParId], references: [id], onDelete: SetNull) // F17
}

// ====================================================================
// PARTIE B — PERSONNEL & RH
// ====================================================================

model Personnel {
  id                    String       @id @default(cuid())
  ecoleId               String
  ecole                 Ecole        @relation(fields: [ecoleId], references: [id])
  utilisateurId         String?      @unique
  utilisateur           Utilisateur? @relation(fields: [utilisateurId], references: [id])
  matricule             String?
  nom                   String
  prenom                String
  dateNaissance         DateTime?
  sexe                  String?
  telephone             String?
  email                 String?
  adresse               String?
  photoUrl              String?
  dateEmbauche          DateTime
  dateSortie            DateTime?
  motifSortie           String?
  statut                String       @default("actif")
  typeContrat           String? // CDI/CDD/vacataire/stagiaire
  salaireBrut           Int? // centimes (F16)
  cvUrl                 String?
  diplomePrincipal      String?
  numeroSecuriteSociale String?
  rib                   String? // M16 — RIB/IBAN pour l'export des virements de paie
  contactUrgence        String? // JSON
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  roles                    PersonnelRole[]
  seances                  Seance[]
  evaluationsDonnees       Evaluation[]
  avancementsDonnes        AvancementProgramme[]
  conges                   Conge[]
  creneauxRdv              CreneauRdv[]
  evaluationsRh            EvaluationPersonnel[]
  remplacementsAbsents     Remplacement[]            @relation("RemplacementsAbsents")
  remplacementsRemplacants Remplacement[]            @relation("RemplacementsRemplacants")
  verificationAntecedents  VerificationAntecedents[]
  habilitationPenales      HabilitationPenale[]
  bulletinPaies            BulletinPaie[]
  variablePaies            VariablePaie[]
  soldeConges              SoldeConge[]
  pointages                PointagePersonnel[] // O3
  devoirs                  Devoir[] // F17
  cahierTextes             CahierTexte[] // F17
  emploiTemps              EmploiTemps[] // F17
  creneauHebdos            CreneauHebdo[] // F17

  @@unique([ecoleId, matricule])
}

model PersonnelRole {
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id])
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  classeId    String?
  classe      Classe?   @relation(fields: [classeId], references: [id]) // F17
  matiereId   String?
  matiere     Matiere?  @relation(fields: [matiereId], references: [id]) // F17
  dateDebut   DateTime  @default(now())
  dateFin     DateTime?

  @@id([personnelId, roleId, dateDebut])
}

model Conge {
  id              String       @id @default(cuid())
  personnelId     String
  personnel       Personnel    @relation(fields: [personnelId], references: [id])
  type            String // annuel/maladie/maternite/exceptionnel
  dateDebut       DateTime
  dateFin         DateTime
  statut          String       @default("demande") // demande/valide/refuse/annule (F3)
  motif           String?
  justificatifUrl String?
  traiteParId     String?
  traitePar       Utilisateur? @relation("CongeTraitePar", fields: [traiteParId], references: [id], onDelete: SetNull) // F17
  updatedAt       DateTime     @updatedAt // F18

  remplacements Remplacement[]

  @@index([personnelId, statut]) // F18
}

model Remplacement {
  id                    String    @id @default(cuid())
  congeId               String?
  conge                 Conge?    @relation(fields: [congeId], references: [id])
  personnelAbsentId     String
  personnelAbsent       Personnel @relation("RemplacementsAbsents", fields: [personnelAbsentId], references: [id])
  personnelRemplacantId String
  personnelRemplacant   Personnel @relation("RemplacementsRemplacants", fields: [personnelRemplacantId], references: [id])
  dateDebut             DateTime
  dateFin               DateTime
  statut                String    @default("planifie")
}

model EvaluationPersonnel {
  id                String    @id @default(cuid())
  personnelId       String
  personnel         Personnel @relation(fields: [personnelId], references: [id])
  evaluateurId      String
  periode           String // "2026-S1"
  criteres          String // JSON
  commentaireGlobal String?
  dateEvaluation    DateTime  @default(now())
}

// ====================================================================
// PARTIE B — PÉDAGOGIQUE (le cœur)
// ====================================================================

model Matiere {
  id          String  @id @default(cuid())
  ecoleId     String
  ecole       Ecole   @relation(fields: [ecoleId], references: [id])
  code        String
  libelle     String
  coefficient Float   @default(1.0)
  couleur     String?

  programmes            Programme[]
  seances               Seance[]
  evaluations           Evaluation[]
  appreciationsBulletin BulletinAppreciation[] // M10
  competences           Competence[]
  manuels               ManuelScolaire[]
  devoirs               Devoir[] // F17
  cahierTextes          CahierTexte[] // F17
  emploiTemps           EmploiTemps[] // F17
  creneauHebdos         CreneauHebdo[] // F17
  personnelRoles        PersonnelRole[] // F17

  @@unique([ecoleId, code])
}

model Programme {
  id                 String        @id @default(cuid())
  ecoleId            String
  ecole              Ecole         @relation(fields: [ecoleId], references: [id]) // F17
  matiereId          String
  matiere            Matiere       @relation(fields: [matiereId], references: [id])
  niveauId           String
  niveau             Niveau        @relation(fields: [niveauId], references: [id])
  anneeScolaireId    String
  anneeScolaire      AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  titre              String
  objectifs          String?
  volumeHorairePrevu Int?
  publie             Boolean       @default(false)

  chapitres Chapitre[]
}

model Chapitre {
  id                 String    @id @default(cuid())
  programmeId        String
  programme          Programme @relation(fields: [programmeId], references: [id])
  titre              String
  ordre              Int
  volumeHorairePrevu Int?
  contenu            String?
  ressources         String? // JSON

  avancements AvancementProgramme[]
  seances     Seance[] // F17
}

model AvancementProgramme {
  id           String    @id @default(cuid())
  chapitreId   String
  chapitre     Chapitre  @relation(fields: [chapitreId], references: [id])
  classeId     String
  classe       Classe    @relation(fields: [classeId], references: [id])
  enseignantId String
  enseignant   Personnel @relation(fields: [enseignantId], references: [id])
  pourcentage  Float     @default(0)
  dateMaj      DateTime  @default(now())
  commentaire  String?

  @@unique([chapitreId, classeId])
}

model Seance {
  id             String       @id @default(cuid())
  classeId       String
  classe         Classe       @relation(fields: [classeId], references: [id])
  matiereId      String
  matiere        Matiere      @relation(fields: [matiereId], references: [id])
  enseignantId   String
  enseignant     Personnel    @relation(fields: [enseignantId], references: [id])
  chapitreId     String?
  chapitre       Chapitre?    @relation(fields: [chapitreId], references: [id]) // F17
  date           DateTime
  heureDebut     String // HH:mm
  heureFin       String
  salleId        String?
  salle          Salle?       @relation(fields: [salleId], references: [id]) // F17
  contenuPrevu   String?
  contenuRealise String?
  statut         String       @default("planifiee") // planifiee/passee/annulee
  emploiTempsId  String?
  emploiTemps    EmploiTemps? @relation(fields: [emploiTempsId], references: [id]) // F20 — liaison EDT réelle (remplace le JSON seancesGenereesIds)

  presences        Presence[]
  reservationSalle ReservationSalle?

  @@index([classeId, date]) // F18
  @@index([enseignantId, date]) // F18
}

model Periode {
  id              String        @id @default(cuid())
  ecoleId         String
  ecole           Ecole         @relation(fields: [ecoleId], references: [id]) // F17
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  libelle         String
  code            String
  dateDebut       DateTime
  dateFin         DateTime
  typeBulletin    String // primaire/college_lycee

  evaluations           Evaluation[]
  bulletins             Bulletin[]
  evaluationsCompetence EvaluationCompetence[]
  appreciationsBulletin BulletinAppreciation[] // M10
  cahierTextes          CahierTexte[] // F17
  conseils              ConseilClasse[] // F17

  // F19 — le code (T1, S1…) est unique PAR ANNÉE, pas pour toute l'école
  @@unique([ecoleId, anneeScolaireId, code])
}

model Evaluation {
  id                 String    @id @default(cuid())
  ecoleId            String
  ecole              Ecole     @relation(fields: [ecoleId], references: [id]) // F17
  classeId           String
  classe             Classe    @relation(fields: [classeId], references: [id])
  matiereId          String
  matiere            Matiere   @relation(fields: [matiereId], references: [id])
  enseignantId       String
  enseignant         Personnel @relation(fields: [enseignantId], references: [id])
  type               String // devoir/composition/interrogation
  intitule           String
  date               DateTime
  sur                Float     @default(20)
  coefficient        Float     @default(1.0)
  periodeId          String
  periode            Periode   @relation(fields: [periodeId], references: [id])
  statut             String    @default("planifiee")
  calculeDansMoyenne Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt // F18

  notes Note[]

  @@index([classeId, periodeId]) // F18
}

model Note {
  id                         String       @id @default(cuid())
  eleveId                    String
  eleve                      Eleve        @relation(fields: [eleveId], references: [id])
  evaluationId               String
  evaluation                 Evaluation   @relation(fields: [evaluationId], references: [id])
  valeur                     Float?
  absent                     Boolean      @default(false)
  dispense                   Boolean      @default(false)
  commentaire                String?
  saisiParId                 String?
  saisiPar                   Utilisateur? @relation("NoteSaisiePar", fields: [saisiParId], references: [id], onDelete: SetNull) // F17
  dateSaisie                 DateTime     @default(now())
  synchroniseDepuisHorsLigne Boolean      @default(false)

  @@unique([eleveId, evaluationId])
  @@index([eleveId]) // F18
}

model RegleCalculMoyenne {
  id                String  @id @default(cuid())
  ecoleId           String
  ecole             Ecole   @relation(fields: [ecoleId], references: [id]) // F17
  cycleId           String
  cycle             Cycle   @relation(fields: [cycleId], references: [id])
  methode           String  @default("moyenne_ponderee")
  inclutAbsents     Boolean @default(false)
  notePlancher      Float?
  notePlafond       Float?
  arrondi           Int     @default(2)
  reglesSpecifiques String? // JSON
}

model Bulletin {
  id                      String                 @id @default(cuid())
  eleveId                 String
  eleve                   Eleve                  @relation(fields: [eleveId], references: [id])
  classeId                String
  classe                  Classe                 @relation(fields: [classeId], references: [id]) // F17
  periodeId               String
  periode                 Periode                @relation(fields: [periodeId], references: [id])
  version                 Int                    @default(1)
  statut                  String                 @default("en_construction")
  // en_construction / en_attente_validation_pp / valide_pp / en_attente_direction / publie / rectifie / annule (F3)
  moyennes                String? // JSON
  moyenneGenerale         Float?
  rang                    Int?
  appreciationGenerale    String?
  decisionConseil         String?
  pdfUrl                  String?
  creeParId               String?
  creePar                 Utilisateur?           @relation("BulletinCreePar", fields: [creeParId], references: [id], onDelete: SetNull) // F17
  dateCreation            DateTime               @default(now())
  dateValidationPp        DateTime?
  validePpParId           String?
  validePpPar             Utilisateur?           @relation("BulletinValidePpPar", fields: [validePpParId], references: [id], onDelete: SetNull) // F17
  dateValidationDirection DateTime?
  valideDirectionParId    String?
  valideDirectionPar      Utilisateur?           @relation("BulletinValideDirectionPar", fields: [valideDirectionParId], references: [id], onDelete: SetNull) // F17
  datePublication         DateTime?
  updatedAt               DateTime               @updatedAt // F18
  bulletinAppreciations   BulletinAppreciation[]

  @@unique([eleveId, periodeId, version])
  @@index([classeId, periodeId]) // F18
}

// Évaluation par compétences (maternelle / cycles non chiffrés)
model Competence {
  id        String   @id @default(cuid())
  ecoleId   String
  ecole     Ecole    @relation(fields: [ecoleId], references: [id]) // F17
  cycleId   String
  cycle     Cycle    @relation(fields: [cycleId], references: [id])
  matiereId String?
  matiere   Matiere? @relation(fields: [matiereId], references: [id])
  libelle   String
  ordre     Int

  evaluations EvaluationCompetence[]
}

model EvaluationCompetence {
  id                String     @id @default(cuid())
  eleveId           String
  eleve             Eleve      @relation(fields: [eleveId], references: [id])
  competenceId      String
  competence        Competence @relation(fields: [competenceId], references: [id])
  periodeId         String
  periode           Periode    @relation(fields: [periodeId], references: [id])
  niveauAcquisition String // non_acquis/en_cours/acquis/maitrise
  commentaire       String?
  evalueParId       String
  date              DateTime   @default(now())

  @@unique([eleveId, competenceId, periodeId])
}

// ====================================================================
// PARTIE B — PRÉSENCES (déjà couvert par Presence + Seance)
// ====================================================================
// (Le model Presence est déclaré dans la section Pédagogique car attaché à une Seance.)

model Presence {
  id                         String       @id @default(cuid())
  eleveId                    String
  eleve                      Eleve        @relation(fields: [eleveId], references: [id])
  seanceId                   String
  seance                     Seance       @relation(fields: [seanceId], references: [id])
  statut                     String // present/absent/retard/excuse
  minuteRetard               Int?
  motifAbsence               String?
  justificatifUrl            String?
  saisiParId                 String?
  saisiPar                   Utilisateur? @relation("PresenceSaisiePar", fields: [saisiParId], references: [id], onDelete: SetNull) // F17
  dateSaisie                 DateTime     @default(now())
  synchroniseDepuisHorsLigne Boolean      @default(false)

  justification JustificationAbsence? // F17

  @@unique([eleveId, seanceId])
  @@index([eleveId]) // F18
  @@index([seanceId]) // F18
}

// ====================================================================
// PARTIE B — VIE SCOLAIRE / DISCIPLINE
// ====================================================================

model Incident {
  id           String       @id @default(cuid())
  eleveId      String
  eleve        Eleve        @relation(fields: [eleveId], references: [id])
  dateHeure    DateTime
  lieu         String?
  type         String // comportement/violence/fraude/autre
  description  String
  gravite      String // leger/modere/grave
  declareParId String?
  declarePar   Utilisateur? @relation("IncidentDeclarePar", fields: [declareParId], references: [id], onDelete: SetNull) // F17
  temoins      String? // JSON

  sanctions Sanction[]

  @@index([eleveId, dateHeure]) // F18
}

model Sanction {
  id               String       @id @default(cuid())
  incidentId       String
  incident         Incident     @relation(fields: [incidentId], references: [id])
  type             String // avertissement/retenue/exclusion/convocation
  description      String
  dateDebut        DateTime?
  dateFin          DateTime?
  dureeHeures      Int?
  statut           String       @default("decidee")
  decideParId      String?
  decidePar        Utilisateur? @relation("SanctionDecidePar", fields: [decideParId], references: [id], onDelete: SetNull) // F17
  notifieParents   Boolean      @default(false)
  dateNotification DateTime?

  @@index([incidentId]) // F18
}

// ====================================================================
// PARTIE B — FINANCES / COMPTABILITÉ
// ====================================================================

model Frais {
  id              String        @id @default(cuid())
  ecoleId         String
  ecole           Ecole         @relation(fields: [ecoleId], references: [id])
  libelle         String
  type            String // scolarite/inscription/cantine/transport/activite
  montant         Int // centimes (F16)
  devise          String
  periodicite     String? // unique/mensuel/trimestriel/annuel
  niveauId        String?
  niveau          Niveau?       @relation(fields: [niveauId], references: [id])
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id]) // F17
  updatedAt       DateTime      @updatedAt // F18

  echeances EcheanceFrais[]
}

model EcheanceFrais {
  id           String   @id @default(cuid())
  eleveId      String
  eleve        Eleve    @relation(fields: [eleveId], references: [id])
  fraisId      String
  frais        Frais    @relation(fields: [fraisId], references: [id])
  montant      Int // centimes (F16)
  remise       Int      @default(0) // centimes — bourse/remise (F19)
  motifRemise  String?
  devise       String
  dateEcheance DateTime
  montantPaye  Int      @default(0) // centimes
  statut       String   @default("impayee") // impayee/partiel/payee/annulee
  source       String?
  dateCreation DateTime @default(now())
  updatedAt    DateTime @updatedAt // F18

  paiements PaiementEcheance[]

  // Idempotence de la génération d'échéances (audit T1) :
  // un même élève ne peut avoir qu'une échéance par (frais, date).
  @@unique([eleveId, fraisId, dateEcheance])
  @@index([eleveId, statut]) // F18
  @@index([dateEcheance]) // F18
}

model Paiement {
  id                   String        @id @default(cuid())
  ecoleId              String
  ecole                Ecole         @relation(fields: [ecoleId], references: [id])
  eleveId              String?
  eleve                Eleve?        @relation(fields: [eleveId], references: [id])
  parentId             String?
  parent               ParentTuteur? @relation(fields: [parentId], references: [id])
  montant              Int // centimes (F16)
  devise               String
  modePaiement         String // espece/cheque/virement/carte/mobile_money
  referenceTransaction String?       @unique // F19 — idempotence des encaissements
  datePaiement         DateTime      @default(now())
  encaisseParId        String?
  encaissePar          Utilisateur?  @relation("PaiementEncaissePar", fields: [encaisseParId], references: [id], onDelete: SetNull) // F17
  recuUrl              String?
  // F19 — annulation traçable (jamais de delete : trace comptable)
  annule               Boolean       @default(false)
  dateAnnulation       DateTime?
  motifAnnulation      String?
  annuleParId          String?
  annulePar            Utilisateur?  @relation("PaiementAnnulePar", fields: [annuleParId], references: [id], onDelete: SetNull)

  echeances    PaiementEcheance[]
  avoirs       AvoirEcole[] // F17
  lignesReleve LigneReleve[] // M15

  @@index([ecoleId, datePaiement]) // F18
}

model PaiementEcheance {
  paiementId      String
  paiement        Paiement      @relation(fields: [paiementId], references: [id], onDelete: Cascade) // F17 — l'allocation suit le paiement
  echeanceId      String
  echeance        EcheanceFrais @relation(fields: [echeanceId], references: [id], onDelete: Cascade)
  montantApplique Int // centimes (F16)

  @@id([paiementId, echeanceId])
}

model Depense {
  id              String       @id @default(cuid())
  ecoleId         String
  ecole           Ecole        @relation(fields: [ecoleId], references: [id])
  categorie       String
  description     String
  montant         Int // centimes (F16)
  devise          String
  dateDepense     DateTime
  fournisseur     String?
  justificatifUrl String?
  creeParId       String?
  creePar         Utilisateur? @relation("DepenseCreePar", fields: [creeParId], references: [id], onDelete: SetNull) // C9
  validee         Boolean      @default(false)
  valideeParId    String?
  valideePar      Utilisateur? @relation("DepenseValideePar", fields: [valideeParId], references: [id], onDelete: SetNull) // F17
  dateValidation  DateTime?
  annulee         Boolean      @default(false) // F19 — annulation traçable
  updatedAt       DateTime     @updatedAt // F18

  @@index([ecoleId, dateDepense]) // F18
}

model StockArticle {
  id           String  @id @default(cuid())
  ecoleId      String
  ecole        Ecole   @relation(fields: [ecoleId], references: [id])
  nom          String
  categorie    String?
  quantite     Int     @default(0)
  seuilAlerte  Int?
  unite        String?
  prixUnitaire Int? // centimes (F16)

  mouvements MouvementStock[]
}

model MouvementStock {
  id            String       @id @default(cuid())
  articleId     String
  article       StockArticle @relation(fields: [articleId], references: [id])
  type          String // entree/sortie
  quantite      Int
  motif         String?
  dateMouvement DateTime     @default(now())
  effectueParId String?
  effectuePar   Utilisateur? @relation("MouvementStockEffectuePar", fields: [effectueParId], references: [id], onDelete: SetNull) // F17

  @@index([articleId, dateMouvement]) // F18
}

// ====================================================================
// PARTIE C.1 — SALLES, RÉSERVATIONS, CALENDRIER SCOLAIRE
// ====================================================================

model Salle {
  id          String @id @default(cuid())
  ecoleId     String
  ecole       Ecole  @relation(fields: [ecoleId], references: [id])
  nom         String
  type        String // classe/labo/informatique/sport/polyvalente
  capacite    Int
  equipements String @default("[]") // JSON list

  reservations     ReservationSalle[]
  batiment         Batiment?          @relation(fields: [batimentId], references: [id])
  batimentId       String?
  etage            Etage?             @relation(fields: [etageId], references: [id])
  etageId          String?
  salleEquipements SalleEquipement[]
  seances          Seance[] // F17
  emploiTemps      EmploiTemps[] // F17
  creneauHebdos    CreneauHebdo[] // F17

  @@unique([ecoleId, nom])
}

model ReservationSalle {
  id           String   @id @default(cuid())
  salleId      String
  salle        Salle    @relation(fields: [salleId], references: [id])
  seanceId     String?  @unique
  seance       Seance?  @relation(fields: [seanceId], references: [id])
  date         DateTime
  heureDebut   String
  heureFin     String
  reserveParId String
  motif        String?
  createdAt    DateTime @default(now())
}

model CalendrierScolaire {
  id              String        @id @default(cuid())
  ecoleId         String
  ecole           Ecole         @relation(fields: [ecoleId], references: [id])
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  type            String // jour_ferie/vacances/journee_pedagogique/evenement
  libelle         String
  dateDebut       DateTime
  dateFin         DateTime
}

// ====================================================================
// PARTIE C.4 — EXAMENS OFFICIELS
// ====================================================================

model ExamenOfficiel {
  id              String        @id @default(cuid())
  ecoleId         String
  ecole           Ecole         @relation(fields: [ecoleId], references: [id])
  nom             String // CEPE/BEPC/BAC
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id]) // F17
  niveauId        String
  niveau          Niveau        @relation(fields: [niveauId], references: [id])
  dateDebut       DateTime
  dateFin         DateTime

  inscriptions InscriptionExamenOfficiel[]
}

model InscriptionExamenOfficiel {
  id                    String         @id @default(cuid())
  examenOfficielId      String
  examenOfficiel        ExamenOfficiel @relation(fields: [examenOfficielId], references: [id])
  eleveId               String
  eleve                 Eleve          @relation(fields: [eleveId], references: [id])
  numeroTable           String?
  centreExamen          String?
  statut                String         @default("inscrit") // inscrit/convoque/presente/absent
  resultat              String? // admis/ajourne/mention
  amenagementAppliqueId String?
  certificatUrl         String?

  @@unique([examenOfficielId, eleveId])
}

// ====================================================================
// PARTIE C.5 — RDV PARENTS-PROFS
// ====================================================================

model CreneauRdv {
  id          String    @id @default(cuid())
  personnelId String
  personnel   Personnel @relation(fields: [personnelId], references: [id])
  date        DateTime
  heureDebut  String
  heureFin    String
  statut      String    @default("disponible") // disponible/reserve/annule
  lieu        String // presentiel/visio
  lienVisio   String?

  rdvs Rdv[]
}

model Rdv {
  id           String       @id @default(cuid())
  creneauRdvId String
  creneauRdv   CreneauRdv   @relation(fields: [creneauRdvId], references: [id])
  parentId     String
  parent       ParentTuteur @relation(fields: [parentId], references: [id])
  eleveId      String?
  eleve        Eleve?       @relation(fields: [eleveId], references: [id])
  motif        String?
  statut       String       @default("confirme") // confirme/annule/honore/absence
  createdAt    DateTime     @default(now())

  @@index([eleveId]) // F18
}

model ReunionCollective {
  id          String   @id @default(cuid())
  classeId    String
  classe      Classe   @relation(fields: [classeId], references: [id])
  date        DateTime
  heure       String
  lieu        String
  description String?
}

// ====================================================================
// PARTIE C.6 — MANUELS & FOURNITURES
// ====================================================================

model ManuelScolaire {
  id            String   @id @default(cuid())
  ecoleId       String
  ecole         Ecole    @relation(fields: [ecoleId], references: [id])
  titre         String
  matiereId     String?
  matiere       Matiere? @relation(fields: [matiereId], references: [id])
  niveauId      String?
  niveau        Niveau?  @relation(fields: [niveauId], references: [id])
  editeur       String?
  anneeEdition  Int?
  quantiteStock Int      @default(0)

  attributions AttributionManuel[]
}

model AttributionManuel {
  id                     String         @id @default(cuid())
  manuelScolaireId       String
  manuelScolaire         ManuelScolaire @relation(fields: [manuelScolaireId], references: [id])
  eleveId                String
  eleve                  Eleve          @relation(fields: [eleveId], references: [id])
  dateAttribution        DateTime
  dateRestitutionPrevue  DateTime?
  etatRemise             String // bon usage endommage
  etatRetour             String?
  statut                 String         @default("en_cours") // en_cours/rendu/perdu/facture
  echeanceFraisGenereeId String?
}

model ListeFourniture {
  id              String        @id @default(cuid())
  niveauId        String
  niveau          Niveau        @relation(fields: [niveauId], references: [id])
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  contenu         String // JSON
  publiee         Boolean       @default(false)
  datePublication DateTime?
}

// ====================================================================
// PARTIE C.7 — SÉCURITÉ PHYSIQUE
// ====================================================================

model Visiteur {
  id                    String    @id @default(cuid())
  ecoleId               String
  ecole                 Ecole     @relation(fields: [ecoleId], references: [id])
  nom                   String
  motifVisite           String
  personneVisiteeId     String?
  dateHeureEntree       DateTime  @default(now())
  dateHeureSortie       DateTime?
  pieceIdentiteVerifiee Boolean   @default(false)
  badgeNumero           String?

  @@index([ecoleId, dateHeureEntree]) // F18
}

model AutorisationSortie {
  id                   String       @id @default(cuid())
  eleveId              String
  eleve                Eleve        @relation(fields: [eleveId], references: [id])
  nomPersonneAutorisee String
  lienAvecEleve        String?
  telephone            String?
  photoUrl             String?
  active               Boolean      @default(true)
  valideeParId         String?
  valideePar           Utilisateur? @relation("AutorisationValidePar", fields: [valideeParId], references: [id], onDelete: SetNull) // F17

  sorties SortieAnticipee[] // F17
}

model SortieAnticipee {
  id                       String              @id @default(cuid())
  eleveId                  String
  eleve                    Eleve               @relation(fields: [eleveId], references: [id])
  date                     DateTime
  heure                    String
  autorisationSortieId     String?
  autorisationSortie       AutorisationSortie? @relation(fields: [autorisationSortieId], references: [id]) // F17
  recupereParNom           String
  validationExceptionnelle Boolean             @default(false)
  valideParId              String?
  validePar                Utilisateur?        @relation("SortieValidePar", fields: [valideParId], references: [id], onDelete: SetNull) // F17
  parentsNotifies          Boolean             @default(false)
  dateSortie               DateTime            @default(now())
}

// ====================================================================
// PARTIE B.9 — SERVICES COMPLÉMENTAIRES (cantine, transport, biblio)
// ====================================================================

model CantineInscription {
  id              String        @id @default(cuid())
  ecoleId         String
  ecole           Ecole         @relation(fields: [ecoleId], references: [id])
  eleveId         String
  eleve           Eleve         @relation(fields: [eleveId], references: [id])
  classeId        String
  classe          Classe        @relation(fields: [classeId], references: [id])
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id]) // F17
  joursSemaine    String // JSON array [1,3,5]
  tarifJournalier Int // centimes (F16)
  actif           Boolean       @default(true)

  @@unique([eleveId, anneeScolaireId]) // F19 — une inscription par élève et par année
}

model TransportLigne {
  id          String  @id @default(cuid())
  ecoleId     String
  ecole       Ecole   @relation(fields: [ecoleId], references: [id])
  nom         String
  vehicule    String?
  chauffeurId String?

  arrets        TransportArret[]
  inscriptions  TransportInscription[]
  feuillesRoute FeuilleRoute[] // O2
}

model TransportArret {
  id       String         @id @default(cuid())
  ligneId  String
  ligne    TransportLigne @relation(fields: [ligneId], references: [id])
  passages PassageArret[]
  nom      String
  ordre    Int
  heure    String
}

