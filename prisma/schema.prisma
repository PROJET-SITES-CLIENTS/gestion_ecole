// POINT 13 — DISPENSES (Partie B Pédagogique)
// --------------------------------------------------------------------

model Dispense {
  id              String    @id @default(cuid())
  ecoleId         String
  ecole           Ecole     @relation(fields: [ecoleId], references: [id])
  eleveId         String
  eleve           Eleve     @relation(fields: [eleveId], references: [id])
  matiereId       String?
  motif           String // medical/sportif/religieux/autre
  description     String
  dateDebut       DateTime
  dateFin         DateTime?
  justificatifUrl String?
  statut          String    @default("demandee") // demandee/validee/refusee
  valideParId     String?
  dateValidation  DateTime?
}

// --------------------------------------------------------------------
// POINT 14 — WORKFLOW JUSTIFICATION D'ABSENCE (Partie B Présences)
// --------------------------------------------------------------------

model JustificationAbsence {
  id                    String    @id @default(cuid())
  ecoleId               String?
  ecole                 Ecole?    @relation(fields: [ecoleId], references: [id])
  eleveId               String
  eleve                 Eleve     @relation(fields: [eleveId], references: [id])
  presenceId            String?   @unique // F17 — 1 présence = 1 justification max
  presence              Presence? @relation(fields: [presenceId], references: [id])
  dateAbsence           DateTime
  dureeHeures           Float?
  motif                 String // maladie/familial/rendez_vous_medical/ceremonie/transport/autre
  description           String?
  justificatifUrl       String?
  statut                String    @default("soumis") // soumis/valide/rejete
  soumisParId           String?
  valideParId           String?
  dateSoumission        DateTime  @default(now())
  dateValidation        DateTime?
  commentaireValidation String?

  @@index([eleveId]) // F18
}

// --------------------------------------------------------------------
// POINT 15 — BUDGETS PRÉVISIONNELS (Partie B Finances)
// --------------------------------------------------------------------

model Budget {
  id              String        @id @default(cuid())
  ecoleId         String
  ecole           Ecole         @relation(fields: [ecoleId], references: [id])
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  libelle         String
  dateDebut       DateTime
  dateFin         DateTime
  statut          String        @default("brouillon") // brouillon/valide/cloture
  valideParId     String?
  dateValidation  DateTime?

  lignes LigneBudget[]
}

model LigneBudget {
  id                 String   @id @default(cuid())
  budgetId           String
  budget             Budget   @relation(fields: [budgetId], references: [id])
  categorie          String // recettes/depenses
  sousCategorie      String // frais_scolarite/subventions/fonctionnement/salaries/equipement
  libelle            String
  montantPrevu       Int // centimes (F16)
  montantRealise     Int      @default(0) // centimes
  devise             String
  pourcentageRealise Float    @default(0)
  dateDerniereMaj    DateTime @default(now())
}

// --------------------------------------------------------------------
// POINT 16 — COMPTABILITÉ GÉNÉRALE (Partie B Finances)
// --------------------------------------------------------------------

model CompteComptable {
  id      String  @id @default(cuid())
  ecoleId String
  ecole   Ecole   @relation(fields: [ecoleId], references: [id])
  numero  String
  libelle String
  type    String // actif/passif/produit/charge
  parent  String?
  solde   Int     @default(0) // centimes (F16)
  devise  String
  actif   Boolean @default(true)

  lignesEcriture LigneEcriture[]
}

model JournalComptable {
  id      String @id @default(cuid())
  ecoleId String
  ecole   Ecole  @relation(fields: [ecoleId], references: [id])
  code    String // VE/ACH/VTE/BQ/OD
  libelle String
  type    String // achat/vente/banque/operations_diverses

  ecritures EcritureComptable[]
}

model EcritureComptable {
  id                    String           @id @default(cuid())
  ecoleId               String
  ecole                 Ecole            @relation(fields: [ecoleId], references: [id])
  journalId             String
  journal               JournalComptable @relation(fields: [journalId], references: [id])
  date                  DateTime         @default(now())
  numeroPiece           String?
  libelle               String
  statut                String           @default("brouillon") // brouillon/valide/annule (typo "brouiller" corrigée — F18)
  valideParId           String?
  dateValidation        DateTime?
  pieceJustificativeUrl String?

  lignes LigneEcriture[]
}

model LigneEcriture {
  id         String            @id @default(cuid())
  ecritureId String
  ecriture   EcritureComptable @relation(fields: [ecritureId], references: [id])
  compteId   String
  compte     CompteComptable   @relation(fields: [compteId], references: [id])
  libelle    String
  debit      Int               @default(0) // centimes (F16)
  credit     Int               @default(0) // centimes
}

// --------------------------------------------------------------------
// POINT 17 — FOURNISSEURS & COMMANDES (Partie B Finances)
// --------------------------------------------------------------------

model Fournisseur {
  id           String   @id @default(cuid())
  ecoleId      String
  ecole        Ecole    @relation(fields: [ecoleId], references: [id])
  nom          String
  type         String // fournisseur_prestataire/sous_traitant
  contact      String?
  email        String?
  telephone    String?
  adresse      String?
  rib          String?
  siret        String?
  statut       String   @default("actif") // actif/bloque/blackliste
  dateCreation DateTime @default(now())

  commandes CommandeFournisseur[]
  factures  FactureFournisseur[]
}

model CommandeFournisseur {
  id                     String      @id @default(cuid())
  ecoleId                String
  ecole                  Ecole       @relation(fields: [ecoleId], references: [id])
  fournisseurId          String
  fournisseur            Fournisseur @relation(fields: [fournisseurId], references: [id])
  numero                 String
  dateCommande           DateTime    @default(now())
  dateLivraisonPrevue    DateTime?
  dateLivraisonEffective DateTime?
  montantTotal           Int // centimes (F16)
  devise                 String
  statut                 String      @default("brouillon") // brouillon/validee/envoyee/recue_partiel/recue_totale/annulee
  valideeParId           String?

  lignes     LigneCommande[]
  receptions ReceptionCommande[]
  factures   FactureFournisseur[] // F17

  @@unique([ecoleId, numero]) // F19
}

model LigneCommande {
  id           String              @id @default(cuid())
  commandeId   String
  commande     CommandeFournisseur @relation(fields: [commandeId], references: [id])
  designation  String
  quantite     Float
  unite        String?
  prixUnitaire Int // centimes (F16)
  montantLigne Int // centimes
  recu         Boolean             @default(false)
}

model ReceptionCommande {
  id               String              @id @default(cuid())
  commandeId       String
  commande         CommandeFournisseur @relation(fields: [commandeId], references: [id])
  dateReception    DateTime            @default(now())
  quantiteRecue    Float
  bonLivraisonUrl  String?
  controleQualite  Boolean             @default(false)
  commentaire      String?
  receptionneParId String?
}

// --------------------------------------------------------------------
// POINT 18 — FACTURES & PAIEMENTS FOURNISSEURS (Partie B Finances)
// --------------------------------------------------------------------

model FactureFournisseur {
  id             String               @id @default(cuid())
  ecoleId        String
  ecole          Ecole                @relation(fields: [ecoleId], references: [id])
  fournisseurId  String
  fournisseur    Fournisseur          @relation(fields: [fournisseurId], references: [id])
  numero         String
  dateEmission   DateTime
  dateReception  DateTime             @default(now())
  dateEcheance   DateTime?
  montantHT      Int // centimes (F16)
  montantTVA     Int                  @default(0) // centimes
  montantTTC     Int // centimes
  devise         String
  statut         String               @default("recue") // recue/controlee/payee/annulee/en_retard
  controleeParId String?
  dateControle   DateTime?
  fichierUrl     String?
  commandeId     String?
  commande       CommandeFournisseur? @relation(fields: [commandeId], references: [id]) // F17

  paiements PaiementFournisseur[]
  avoirs    AvoirEcole[] // F17

  @@unique([ecoleId, numero]) // F19
}

model PaiementFournisseur {
  id           String             @id @default(cuid())
  ecoleId      String
  ecole        Ecole              @relation(fields: [ecoleId], references: [id])
  factureId    String
  facture      FactureFournisseur @relation(fields: [factureId], references: [id])
  datePaiement DateTime           @default(now())
  montant      Int // centimes (F16)
  devise       String
  mode         String // virement/cheque/especes/carte
  reference    String?
  payeParId    String?
}

// --------------------------------------------------------------------
// POINT 19 — AVOIRS / CREDIT NOTES ÉCOLE (Partie B Finances)
// --------------------------------------------------------------------

model AvoirEcole {
  id                   String              @id @default(cuid())
  ecoleId              String
  ecole                Ecole               @relation(fields: [ecoleId], references: [id])
  numero               String
  dateEmission         DateTime            @default(now())
  montant              Int // centimes (F16)
  devise               String
  motif                String
  paiementLieId        String?
  paiementLie          Paiement?           @relation(fields: [paiementLieId], references: [id]) // F17
  factureFournisseurId String?
  factureFournisseur   FactureFournisseur? @relation(fields: [factureFournisseurId], references: [id]) // F17
  statut               String              @default("emis") // emis/utilise/annule
  emisParId            String?

  @@unique([ecoleId, numero]) // F19
}

// --------------------------------------------------------------------
// POINT 20 — MESSAGERIE INTERNE (Partie B Communication)
// --------------------------------------------------------------------

model Conversation {
  id               String    @id @default(cuid())
  ecoleId          String
  ecole            Ecole     @relation(fields: [ecoleId], references: [id])
  titre            String
  type             String    @default("direct") // direct/groupe/annonce/classe
  creeParId        String?
  dateCreation     DateTime  @default(now())
  dernierMessageAt DateTime?

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  utilisateurId    String
  role             String       @default("membre") // admin/membre/lecture_seule
  dateAjout        DateTime     @default(now())
  dernierLectureAt DateTime?
  archive          Boolean      @default(false)
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  expediteurId   String
  contenu        String
  dateEnvoi      DateTime     @default(now())
  supprime       Boolean      @default(false)
  luPar          String? // JSON array of user IDs

  piecesJointes PieceJointe[]
}

model PieceJointe {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id])
  nomFichier String
  url        String
  taille     Int?
  mimeType   String?
  dateUpload DateTime @default(now())
}

// --------------------------------------------------------------------
// POINT 21 — ANNONCES / PUBLICATIONS (Partie B Communication)
// --------------------------------------------------------------------

model Annonce {
  id              String    @id @default(cuid())
  ecoleId         String
  ecole           Ecole     @relation(fields: [ecoleId], references: [id])
  titre           String
  contenu         String
  auteurId        String?
  datePublication DateTime?
  dateExpiration  DateTime?
  statut          String    @default("brouillon") // brouillon/publie/archive/expire
  cible           String // toute_ecole/cycle/niveau/classe/personnel/parents
  cibleIds        String? // JSON array when cible=cycle/niveau/classe
  pinned          Boolean   @default(false)
  pieceJointeUrl  String?

  lectures AnnonceLecture[]
}

model AnnonceLecture {
  id            String   @id @default(cuid())
  annonceId     String
  annonce       Annonce  @relation(fields: [annonceId], references: [id])
  utilisateurId String
  dateLecture   DateTime @default(now())

  @@unique([annonceId, utilisateurId])
}

// --------------------------------------------------------------------
// POINT 22 — SMS LOG (Partie B Communication)
// --------------------------------------------------------------------

model SmsLog {
  id                String    @id @default(cuid())
  ecoleId           String?
  ecole             Ecole?    @relation(fields: [ecoleId], references: [id])
  notificationId    String?
  destinataire      String
  expediteur        String?
  message           String
  provider          String // twilio/orange_api/vonage/local
  providerMessageId String?
  statut            String    @default("en_attente") // en_attente/envoye/delivre/echec/rejete
  coutUnitaire      Int       @default(0) // centimes (F16)
  coutTotal         Int       @default(0) // centimes
  segments          Int       @default(1)
  dateEnvoi         DateTime?
  dateLivraison     DateTime?
  dateCreation      DateTime  @default(now())
  codeErreur        String?
  tentative         Int       @default(0)

  @@index([ecoleId, dateCreation]) // F18
}

// --------------------------------------------------------------------
// POINT 23 — PUSH NOTIFICATIONS & DEVICES (Partie B Communication)
// F20 — DeviceMobile et PushToken fusionnés : UN seul modèle de token enrichi.
// --------------------------------------------------------------------

model PushToken {
  id               String      @id @default(cuid())
  utilisateurId    String
  utilisateur      Utilisateur @relation("PushTokenUser", fields: [utilisateurId], references: [id], onDelete: Cascade) // F17
  token            String      @unique // F19
  provider         String // fcm/apns/web_push
  p256dh           String? // E19 — clé publique d'abonnement web-push
  authKey          String? // E19 — secret d'abonnement web-push
  plateforme       String? // ios/android/web/pwa
  deviceModel      String?
  osVersion        String?
  appVersion       String?
  langue           String?
  actif            Boolean     @default(true)
  dateCreation     DateTime    @default(now())
  derniereActivite DateTime?
}

model PushNotificationLog {
  id                String    @id @default(cuid())
  ecoleId           String?
  notificationId    String?
  pushTokenId       String
  titre             String
  corps             String
  statut            String    @default("en_attente") // en_attente/envoye/delivre/echec
  providerMessageId String?
  dateEnvoi         DateTime?
  dateLivraison     DateTime?
  dateCreation      DateTime  @default(now())
  clic              Boolean   @default(false)
}

// --------------------------------------------------------------------
// POINT 24 — SESSIONS ACTIVES (Partie B Sécurité)
// --------------------------------------------------------------------

model SessionUtilisateur {
  id                   String      @id @default(cuid())
  utilisateurId        String
  utilisateur          Utilisateur @relation("SessionUtilisateurUser", fields: [utilisateurId], references: [id], onDelete: Cascade) // F17
  tokenHash            String      @unique // F19
  ecoleActiveId        String? // D5
  fingerprint          String? // hash du navigateur/device
  adresseIp            String?
  userAgent            String?
  deviceType           String? // desktop/mobile/tablet
  localisation         String? // ville/pays
  dateCreation         DateTime    @default(now())
  dateDerniereActivite DateTime?
  dateExpiration       DateTime
  expireManuellement   Boolean     @default(false)
  active               Boolean     @default(true)
}

// --------------------------------------------------------------------
// POINT 25 — 2FA COMPLET (Partie B Sécurité)
// --------------------------------------------------------------------

model TwoFactorMethod {
  id                  String      @id @default(cuid())
  utilisateurId       String
  utilisateur         Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade) // F17
  methode             String // totp/sms/email/backup_codes
  secret              String? // secret TOTP base32 (F10 — vérifié à la connexion)
  telephone           String?
  email               String?
  actif               Boolean     @default(true)
  dateActivation      DateTime    @default(now())
  derniereUtilisation DateTime?
}

model TwoFactorBackupCode {
  id              String      @id @default(cuid())
  utilisateurId   String
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade) // F17
  codeHash        String
  utilise         Boolean     @default(false)
  dateUtilisation DateTime?
  dateGeneration  DateTime    @default(now())
}

// --------------------------------------------------------------------
// POINT 26 — TOKENS D'AUTHENTIFICATION (Partie B Sécurité)
// --------------------------------------------------------------------

model JetonAuth {
  id              String       @id @default(cuid())
  utilisateurId   String?
  utilisateur     Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: Cascade) // F17
  email           String
  type            String // reset_password/verify_email/magic_link/change_email/2fa_challenge
  tokenHash       String       @unique // F19
  expireLe        DateTime
  utilise         Boolean      @default(false)
  dateUtilisation DateTime?
  dateCreation    DateTime     @default(now())
  adresseIp       String?
  userAgent       String?
}

model TentativeConnexion {
  id            Int          @id @default(autoincrement())
  utilisateurId String?
  utilisateur   Utilisateur? @relation("TentativeConnexionUser", fields: [utilisateurId], references: [id], onDelete: SetNull) // F17
  email         String
  adresseIp     String?
  userAgent     String?
  succes        Boolean
  motifEchec    String?
  date          DateTime     @default(now())

  @@index([adresseIp, date]) // F18 — base du throttling par IP (F11)
  @@index([email, date]) // F18
}

// --------------------------------------------------------------------
// POINT 27 — API TOKENS PUBLICS (Partie B API publique)
// --------------------------------------------------------------------

model ApiToken {
  id                String    @id @default(cuid())
  ecoleId           String?
  ecole             Ecole?    @relation(fields: [ecoleId], references: [id])
  nom               String
  description       String?
  tokenHash         String
  prefix            String // 8 premiers caractères visibles
  scopes            String    @default("[]") // JSON
  tauxLimiteHoraire Int       @default(1000)
  actif             Boolean   @default(true)
  dateCreation      DateTime  @default(now())
  dateExpiration    DateTime?
  dernierUsage      DateTime?
  totalRequettes    Int       @default(0)

  logs ApiTokenLog[]
}

model ApiTokenLog {
  id           Int      @id @default(autoincrement())
  apiTokenId   String
  apiToken     ApiToken @relation(fields: [apiTokenId], references: [id])
  endpoint     String
  methode      String
  statut       Int
  tempsReponse Int
  adresseIp    String?
  date         DateTime @default(now())
}

// --------------------------------------------------------------------
// POINT 28 — WEBHOOKS SORTANTS (Partie B API publique)
// --------------------------------------------------------------------

model WebhookSortant {
  id           String    @id @default(cuid())
  ecoleId      String?
  ecole        Ecole?    @relation(fields: [ecoleId], references: [id])
  url          String
  secret       String?
  events       String    @default("[]") // JSON array of event codes
  actif        Boolean   @default(true)
  dateCreation DateTime  @default(now())
  dernierEnvoi DateTime?

  livraisons WebhookDelivery[]
}

model WebhookDelivery {
  id                 String         @id @default(cuid())
  webhookId          String
  webhook            WebhookSortant @relation(fields: [webhookId], references: [id])
  event              String
  payload            String // JSON
  statutHttp         Int?
  reponseCorps       String?
  tentative          Int            @default(0)
  statut             String         @default("en_attente") // en_attente/livre/echec
  dateCreation       DateTime       @default(now())
  dateEnvoi          DateTime?
  prochaineTentative DateTime?
}

// --------------------------------------------------------------------
// POINT 29 — DEMANDES D'EFFACEMENT RGPD (Partie B RGPD)
// --------------------------------------------------------------------

model DemandeEffacement {
  id                 String    @id @default(cuid())
  ecoleId            String?
  utilisateurId      String?
  cibleType          String // eleve/parent/personnel/utilisateur
  cibleId            String
  motif              String // droit_effacement/obligation_legale/demande_sujet
  description        String?
  statut             String    @default("recu") // recu/en_cours/anonymise/refuse
  dateDemande        DateTime  @default(now())
  dateTraitement     DateTime?
  traiteParId        String?
  donneesAnonymisees String? // JSON log
}

// --------------------------------------------------------------------
// POINT 30 — EXPORT DONNÉES / PORTABILITÉ (Partie B RGPD)
// --------------------------------------------------------------------

model ExportDonnees {
  id             String    @id @default(cuid())
  ecoleId        String?
  utilisateurId  String?
  cibleType      String
  cibleId        String
  format         String    @default("json") // json/csv/zip
  statut         String    @default("en_cours") // en_cours/genere/echec/expire
  fichierUrl     String?
  tailleOctets   Int?
  dateDemande    DateTime  @default(now())
  dateGeneration DateTime?
  dateExpiration DateTime?
}

// --------------------------------------------------------------------
// POINT 31 — CONSENTEMENTS (Partie B RGPD)
// --------------------------------------------------------------------

model ConsentementImage {
  id                String    @id @default(cuid())
  ecoleId           String
  ecole             Ecole     @relation(fields: [ecoleId], references: [id])
  eleveId           String
  eleve             Eleve     @relation(fields: [eleveId], references: [id])
  accord            Boolean   @default(false)
  usage             String // site_web/reseaux_sociaux/plaquette/presse/exposition_interne
  dateAccord        DateTime?
  valideParParentId String?
  duree             String? // annee_scolaire/perpetuel/campagne
  dateCreation      DateTime  @default(now())
  dateMaj           DateTime  @updatedAt
}

model ConsentementCommunication {
  id            String    @id @default(cuid())
  ecoleId       String
  ecole         Ecole     @relation(fields: [ecoleId], references: [id])
  utilisateurId String?
  eleveId       String?
  canal         String // email/sms/push/courrier
  accord        Boolean   @default(false)
  dateAccord    DateTime?
  dateRetrait   DateTime?
  motif         String?
}

// --------------------------------------------------------------------
// POINT 32 — REGISTRE DES TRAITEMENTS (Partie B RGPD Article 30)
// --------------------------------------------------------------------

model RegistreTraitement {
  id                  String   @id @default(cuid())
  ecoleId             String?
  ecole               Ecole?   @relation(fields: [ecoleId], references: [id])
  nom                 String
  finalite            String
  baseLegale          String // consentement/contrat/obligation_legale/interet_vital/mission_publique/interet_legitime
  donneesTraitees     String // JSON
  categoriesPersonnes String // JSON: eleves/parents/personnels...
  destinataires       String?
  transfertsHorsUE    String?
  dureeConservation   String
  mesuresSecurite     String?
  responsable         String?
  dpo                 String?
  dateCreation        DateTime @default(now())
  dateMaj             DateTime @updatedAt
}

// --------------------------------------------------------------------
// POINT 33 — DOMAINE PERSONNALISÉ & THÈME (Partie A SaaS)
// --------------------------------------------------------------------

model DomainePersonnalise {
  id                  String    @id @default(cuid())
  ecoleId             String
  ecole               Ecole     @relation(fields: [ecoleId], references: [id])
  domaine             String    @unique
  verifie             Boolean   @default(false)
  enAttente           Boolean   @default(true)
  enregistrementCname String?
  certificatSSL       String?
  certificatExpireLe  DateTime?
  dateAjout           DateTime  @default(now())
  dateVerification    DateTime?
}

model ThemeEcole {
  id                String   @id @default(cuid())
  ecoleId           String   @unique
  ecole             Ecole    @relation(fields: [ecoleId], references: [id])
  couleurPrimaire   String   @default("#0f766e")
  couleurSecondaire String   @default("#0ea5e9")
  couleurAccent     String   @default("#f59e0b")
  couleurFond       String   @default("#f9fafb")
  logoSidebarUrl    String?
  faviconUrl        String?
  policeFamille     String   @default("Inter")
  customCssUrl      String?
  nomProduit        String? // nom personnalisé affiché (white-label)
  dateMaj           DateTime @updatedAt
}

// --------------------------------------------------------------------
// POINT 34 — FEATURE FLAGS, QUOTAS, STRIPE WEBHOOKS (Partie A SaaS)
// --------------------------------------------------------------------

model FeatureFlag {
  id                 String   @id @default(cuid())
  code               String   @unique
  description        String?
  actifGlobal        Boolean  @default(false)
  rolloutPourcentage Int      @default(0)
  dateCreation       DateTime @default(now())
  dateMaj            DateTime @updatedAt

  ecoles FeatureFlagEcole[]
}

model FeatureFlagEcole {
  id             String      @id @default(cuid())
  featureFlagId  String
  featureFlag    FeatureFlag @relation(fields: [featureFlagId], references: [id])
  ecoleId        String
  ecole          Ecole       @relation(fields: [ecoleId], references: [id])
  actif          Boolean     @default(false)
  dateActivation DateTime    @default(now())

  @@unique([featureFlagId, ecoleId])
}

model QuotaUsage {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  periode         String // "2026-08" pour mensuel, "2026" pour annuel
  ressource       String // eleves/sms_envoyes/storage_go/api_calls
  consommation    Int      @default(0)
  limite          Int?
  pourcentage     Float    @default(0)
  alerte80        Boolean  @default(false)
  alerte100       Boolean  @default(false)
  dateDerniereMaj DateTime @default(now())

  @@unique([ecoleId, periode, ressource])
}

model StripeEvent {
  id             String    @id @default(cuid())
  eventIdStripe  String    @unique
  type           String // invoice.payment_succeeded/customer.subscription_updated/...
  donnees        String // JSON
  traite         Boolean   @default(false)
  dateReception  DateTime  @default(now())
  dateTraitement DateTime?
  erreur         String?
}

model AvoirSaas {
  id                 String   @id @default(cuid())
  ecoleId            String
  ecole              Ecole    @relation(fields: [ecoleId], references: [id])
  factureSaasLieeId  String?
  numero             String
  dateEmission       DateTime @default(now())
  montant            Int // centimes (F16)
  devise             String
  motif              String // remboursement/erreur_facturation/annulation_abonnement
  statut             String   @default("emis") // emis/utilise/annule
  stripeCreditNoteId String?

  @@unique([ecoleId, numero]) // F19
}

// --------------------------------------------------------------------
// POINT 35 — PLANS D'ACCOMPAGNEMENT PPS/PAP/PAI/PAPSI (Partie C.2 Inclusion)
// --------------------------------------------------------------------

model PlanAccompagnement {
  id                String    @id @default(cuid())
  ecoleId           String
  ecole             Ecole     @relation(fields: [ecoleId], references: [id])
  eleveId           String
  eleve             Eleve     @relation(fields: [eleveId], references: [id])
  type              String // PPS/PAP/PAI/PAPSI
  dateMiseEnPlace   DateTime  @default(now())
  dateDebut         DateTime
  dateFin           DateTime?
  statut            String    @default("actif") // actif/en_revision/suspendu/clos
  diagnostic        String?
  objectifsGeneraux String?
  frequenceSuivi    String? // mensuel/trimestriel/annuel
  redigeParId       String?
  valideParId       String?
  dateValidation    DateTime?

  membres   MembreEquipeEducatif[]
  objectifs ObjectifPlan[]
  revisions RevisionPlan[]
}

model MembreEquipeEducatif {
  id                   String             @id @default(cuid())
  planAccompagnementId String
  planAccompagnement   PlanAccompagnement @relation(fields: [planAccompagnementId], references: [id])
  utilisateurId        String
  role                 String // referent/enseignant/orthophoniste/psychologue/ergotherapeute/parent/medecin/avs
  dateInclusion        DateTime           @default(now())
}

model ObjectifPlan {
  id                   String             @id @default(cuid())
  planAccompagnementId String
  planAccompagnement   PlanAccompagnement @relation(fields: [planAccompagnementId], references: [id])
  description          String
  domaine              String // scolaire/social/comportemental/therapeutique
  indicateurs          String?
  echeance             DateTime?
  atteint              Boolean            @default(false)
  dateEvaluation       DateTime?
}

model RevisionPlan {
  id                   String             @id @default(cuid())
  planAccompagnementId String
  planAccompagnement   PlanAccompagnement @relation(fields: [planAccompagnementId], references: [id])
  date                 DateTime           @default(now())
  motif                String
  constats             String
  ajustements          String?
  redigeParId          String?
}

// --------------------------------------------------------------------
// POINT 36 — TEMPLATES PDF, DOCUMENTS GÉNÉRÉS, SIGNATURE, RAPPORTS (Partie B/D)
// --------------------------------------------------------------------

model TemplateDocument {
  id                   String           @id @default(cuid())
  ecoleId              String?
  ecole                Ecole?           @relation(fields: [ecoleId], references: [id])
  code                 String // bulletin/facture/certificat_scolarite/convocation/releve_notes
  libelle              String
  type                 String // html_template/latex/docx_template
  contenuTemplate      String
  variablesDisponibles String? // JSON
  langue               String           @default("fr")
  actif                Boolean          @default(true)
  dateCreation         DateTime         @default(now())
  dateMaj              DateTime         @updatedAt
  documentGeneres      DocumentGenere[]
}

model DocumentGenere {
  id             String            @id @default(cuid())
  ecoleId        String?
  ecole          Ecole?            @relation(fields: [ecoleId], references: [id])
  templateId     String?
  template       TemplateDocument? @relation(fields: [templateId], references: [id])
  cibleType      String
  cibleId        String
  titre          String
  format         String            @default("pdf") // pdf/docx/html
  fichierUrl     String
  tailleOctets   Int?
  version        Int               @default(1)
  genereParId    String?
  dateGeneration DateTime          @default(now())
  hashContenu    String?

  signatures SignatureElectronique[]
}

model SignatureElectronique {
  id                String         @id @default(cuid())
  documentGenereId  String
  documentGenere    DocumentGenere @relation(fields: [documentGenereId], references: [id])
  signataireId      String
  signataireNom     String
  hashDocument      String
  certificat        String?
  horodatageRFC3161 String?
  dateSignature     DateTime       @default(now())
  adresseIp         String?
  userAgent         String?
  niveau            String         @default("simple") // simple/qualifie/avance (eIDAS)
}

model RapportSauvegarde {
  id                String    @id @default(cuid())
  ecoleId           String?
  ecole             Ecole?    @relation(fields: [ecoleId], references: [id])
  utilisateurId     String
  nom               String
  type              String // kpi_tableau_bord/listing/agregat
  configuration     String // JSON: filtres + colonnes + période
  format            String    @default("table") // table/chart/export_pdf
  partage           Boolean   @default(false)
  dateCreation      DateTime  @default(now())
  derniereExecution DateTime?
}

model WidgetDashboard {
  id            String   @id @default(cuid())
  utilisateurId String
  titre         String
  type          String // kpi/chart/tableau/iframe
  source        String // sql/endpoint/manuel
  configuration String // JSON
  position      Int      @default(0)
  taille        String   @default("md") // sm/md/lg/xl
  actif         Boolean  @default(true)
  dateCreation  DateTime @default(now())
}

// --------------------------------------------------------------------
// POINT 37 — HIÉRARCHIE SALLES, RÉCURRENCE iCal, ÉQUIPEMENTS (Partie C.1)
// --------------------------------------------------------------------

model Batiment {
  id               String    @id @default(cuid())
  ecoleId          String
  ecole            Ecole     @relation(fields: [ecoleId], references: [id])
  nom              String
  adresse          String?
  nombreEtages     Int       @default(1)
  accessibilitePMR Boolean   @default(false)
  dateConstruction DateTime?
  dateMaj          DateTime  @updatedAt

  etages Etage[]
  salles Salle[]
}

model Etage {
  id         String   @id @default(cuid())
  batimentId String
  batiment   Batiment @relation(fields: [batimentId], references: [id])
  numero     Int
  libelle    String
  planUrl    String?

  salles Salle[]
}

model SalleEquipement {
  id                      String    @id @default(cuid())
  salleId                 String
  salle                   Salle     @relation(fields: [salleId], references: [id])
  type                    String // videoprojecteur/TBI/ordinateur/climatisation/prises_accessibilite
  quantite                Int       @default(1)
  etat                    String    @default("fonctionnel") // fonctionnel/panne/maintenance
  dateDerniereMaintenance DateTime?
}

// --------------------------------------------------------------------
// EXTENSIONS DES MODÈLES EXISTANTS (back-relations)
// --------------------------------------------------------------------

// Ecole — ajouter back-relations (seront fusionnées lors du format)
// Note: Prisma gère automatiquement les back-relations via @relation,
// pas besoin de modifier Ecole manuellement.

// --------------------------------------------------------------------
// SANTÉ & INFIRMERIE (P2 — complétude gestion scolaire)
// --------------------------------------------------------------------

model FicheSante {
  id                     String   @id @default(cuid())
  ecoleId                String
  ecole                  Ecole    @relation(fields: [ecoleId], references: [id])
  eleveId                String   @unique
  eleve                  Eleve    @relation(fields: [eleveId], references: [id])
  groupeSanguin          String?
  allergies              String?
  traitementsEnCours     String?
  antecedents            String?
  medecinTraitant        String?
  telephoneUrgence       String?
  contactUrgenceNom      String?
  autorisationTraitement Boolean  @default(false)
  dateMiseAJour          DateTime @default(now())
  misAJourParId          String?

  passages     PassageInfirmerie[]
  vaccinations Vaccination[]
}

model PassageInfirmerie {
  id               String      @id @default(cuid())
  ecoleId          String
  ecole            Ecole       @relation(fields: [ecoleId], references: [id])
  eleveId          String
  eleve            Eleve       @relation(fields: [eleveId], references: [id])
  ficheSanteId     String?
  ficheSante       FicheSante? @relation(fields: [ficheSanteId], references: [id])
  datePassage      DateTime    @default(now())
  motif            String
  symptomes        String?
  soinsAdministres String?
  temperature      Float?
  personnelId      String?
  issue            String      @default("retour_classe") // retour_classe/parents_contactes/depart_hopital/retour_domicile
  parentsNotifies  Boolean     @default(false)
  commentaire      String?
}

model Vaccination {
  id              String      @id @default(cuid())
  ecoleId         String
  ecole           Ecole       @relation(fields: [ecoleId], references: [id])
  eleveId         String
  eleve           Eleve       @relation(fields: [eleveId], references: [id])
  vaccin          String
  dateVaccination DateTime?
  dateRappel      DateTime?
  statut          String      @default("a_jour") // a_jour/rappel_prevu/manquant
  certificatUrl   String?
  note            String?
  ficheSante      FicheSante? @relation(fields: [ficheSanteId], references: [id])
  ficheSanteId    String?
}

// ====================================================================
// ANGLES MORTS — extensions W (sauvegardes, fichiers, emails, paie,
// multi-établissement)
// ====================================================================

model Sauvegarde {
  id           String   @id @default(cuid())
  nomFichier   String
  tailleOctets Int
  checksum     String?
  type         String   @default("manuelle") // manuelle/automatique/pre-restauration
  statut       String   @default("reussie")
  creeParId    String?
  dateCreation DateTime @default(now())
  ecole        Ecole?   @relation(fields: [ecoleId], references: [id])
  ecoleId      String?

  @@index([dateCreation])
}

model StockageFichier {
  id           String   @id @default(cuid())
  ecoleId      String
  ecole        Ecole    @relation(fields: [ecoleId], references: [id])
  nomFichier   String
  chemin       String
  mimeType     String
  tailleOctets Int
  confidentiel Boolean  @default(true)
  cibleType    String?
  cibleId      String?
  uploadeParId String?
  dateUpload   DateTime @default(now())

  @@index([ecoleId, dateUpload])
}

model EmailLog {
  id           String    @id @default(cuid())
  ecoleId      String?
  destinataire String
  sujet        String
  message      String
  statut       String    @default("en_attente")
  erreur       String?
  dateEnvoi    DateTime?
  dateCreation DateTime  @default(now())
  ecole        Ecole?    @relation(fields: [ecoleId], references: [id])

  @@index([ecoleId, dateCreation])
}

model ConfigurationPaie {
  id                String   @id @default(cuid())
  ecoleId           String   @unique
  ecole             Ecole    @relation(fields: [ecoleId], references: [id])
  tauxEmployeur     Float    @default(0.084)
  tauxSalarie       Float    @default(0.0524)
  primesRecurrentes String   @default("[]")
  majParId          String?
  dateMaj           DateTime @default(now()) @updatedAt
}

model UtilisateurEcole {
  id            String      @id @default(cuid())
  utilisateurId String
  utilisateur   Utilisateur @relation("UtilisateurEcoleUser", fields: [utilisateurId], references: [id], onDelete: Cascade)
  ecoleId       String
  ecole         Ecole       @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  roleLibelle   String?
  dateAjout     DateTime    @default(now())

  @@unique([utilisateurId, ecoleId])
}

// ====================================================================
// VIE QUOTIDIENNE (O1-O3, M8) — cantine du jour, transport journalier,
// garderie, pointage du personnel
// ====================================================================

model CantineMenu {
  id             String   @id @default(cuid())
  ecoleId        String
  ecole          Ecole    @relation(fields: [ecoleId], references: [id])
  date           DateTime
  platPrincipal  String
  accompagnement String?
  dessert        String?
  allergenes     String   @default("[]")

  @@unique([ecoleId, date])
}

model CantinePresence {
  id      String   @id @default(cuid())
  ecoleId String
  ecole   Ecole    @relation(fields: [ecoleId], references: [id])
  eleveId String
  eleve   Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  date    DateTime
  present Boolean  @default(true)

  @@unique([eleveId, date])
  @@index([ecoleId, date])
}

model FeuilleRoute {
  id          String         @id @default(cuid())
  ecoleId     String
  ecole       Ecole          @relation(fields: [ecoleId], references: [id])
  ligneId     String
  ligne       TransportLigne @relation(fields: [ligneId], references: [id])
  date        DateTime
  statut      String         @default("planifiee")
  commentaire String?
  retardMin   Int            @default(0)

  passages PassageArret[]

  @@unique([ligneId, date])
  @@index([ecoleId, date])
}

model PassageArret {
  id               String         @id @default(cuid())
  feuilleId        String
  feuille          FeuilleRoute   @relation(fields: [feuilleId], references: [id], onDelete: Cascade)
  arretId          String
  arret            TransportArret @relation(fields: [arretId], references: [id])
  heurePrevue      String
  heureReelle      String?
  montes           String         @default("[]")
  descendus        String         @default("[]")
  transportArretId String?
}

model PointagePersonnel {
  id           String    @id @default(cuid())
  ecoleId      String
  ecole        Ecole     @relation(fields: [ecoleId], references: [id])
  personnelId  String
  personnel    Personnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  date         DateTime
  heureArrivee DateTime?
  heureDepart  DateTime?
  retardMin    Int       @default(0)
  commentaire  String?

  @@unique([personnelId, date])
  @@index([ecoleId, date])
}

model GarderieInscription {
  id           String  @id @default(cuid())
  ecoleId      String
  ecole        Ecole   @relation(fields: [ecoleId], references: [id])
  eleveId      String  @unique
  eleve        Eleve   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  formule      String  @default("horaire")
  tarifHoraire Int     @default(0)
  actif        Boolean @default(true)
}

model GarderieSession {
  id               String    @id @default(cuid())
  ecoleId          String
  ecole            Ecole     @relation(fields: [ecoleId], references: [id])
  eleveId          String
  eleve            Eleve     @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  date             DateTime
  heureArrivee     DateTime
  heureDepart      DateTime?
  minutesFacturees Int?

  @@index([ecoleId, date])
}

// M7 — Activités extrascolaires / sorties / voyages

model Activite {
  id          String   @id @default(cuid())
  ecoleId     String
  ecole       Ecole    @relation(fields: [ecoleId], references: [id])
  type        String   @default("activite")
  titre       String
  description String?
  destination String?
  dateDebut   DateTime
  dateFin     DateTime
  cout        Int      @default(0)
  devise      String   @default("XOF")
  capacite    Int?
  statut      String   @default("planifiee")
  creeParId   String?

  participants ActiviteParticipant[]

  @@index([ecoleId, dateDebut])
}

model ActiviteParticipant {
  id               String    @id @default(cuid())
  activiteId       String
  activite         Activite  @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  eleveId          String
  eleve            Eleve     @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  statut           String    @default("inscrit")
  autorisation     String    @default("en_attente")
  dateAutorisation DateTime?
  paiementStatut   String    @default("non_exigible")

  @@unique([activiteId, eleveId])
}

// M10 — Appréciation par matière

model BulletinAppreciation {
  id           String   @id @default(cuid())
  bulletinId   String
  bulletin     Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  matiereId    String
  matiere      Matiere  @relation(fields: [matiereId], references: [id])
  appreciation String
  enseignantId String?
  periode      Periode? @relation(fields: [periodeId], references: [id])
  periodeId    String?

  @@unique([bulletinId, matiereId])
}

// M15 — Rapprochement bancaire

model LigneReleve {
  id         String    @id @default(cuid())
  ecoleId    String
  ecole      Ecole     @relation(fields: [ecoleId], references: [id])
  date       DateTime
  montant    Int
  libelle    String
  rapprochee Boolean   @default(false)
  paiementId String?
  paiement   Paiement? @relation(fields: [paiementId], references: [id], onDelete: SetNull)

  @@index([ecoleId, date])
}
