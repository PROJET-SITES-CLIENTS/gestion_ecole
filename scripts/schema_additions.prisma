

// ====================================================================
// EXTENSION V4 — 37 FAILLES CORRIGÉES
// Ajouts aux 71 modèles existants pour couverture complète du cahier V4
// ====================================================================

// --------------------------------------------------------------------
// POINT 1 — TICKETS SUPPORT SAAS (Partie A)
// --------------------------------------------------------------------

model Ticket {
  id              String   @id @default(cuid())
  ecoleId         String?
  ecole           Ecole?   @relation(fields: [ecoleId], references: [id])
  sujet           String
  description     String
  categorie       String   @default("fonctionnel") // fonctionnel/technique/facturation/demande
  priorite        String   @default("normale") // basse/normale/haute/critique
  statut          String   @default("ouvert") // ouvert/en_cours/en_attente_client/resolu/ferme
  slaContractuelHeures Int?
  slaEcheance     DateTime?
  creeParId       String?
  assigneAId      String?
  dateCreation     DateTime @default(now())
  dateCloture     DateTime?
  delaiResolutionMinutes Int?

  messages        TicketMessage[]
  historique      TicketStatutHistorique[]
}

model TicketMessage {
  id              String   @id @default(cuid())
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id])
  auteurId        String?
  auteurRole      String   // support_editeur/direction_ecole/enseignant/parent
  message         String
  pieceJointeUrl  String?
  interne         Boolean  @default(false) // note interne équipe éditeur
  dateEnvoi       DateTime @default(now())
}

model TicketStatutHistorique {
  id              Int      @id @default(autoincrement())
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id])
  ancienStatut    String?
  nouveauStatut   String
  modifieParId    String?
  dateChangement  DateTime @default(now())
}

// --------------------------------------------------------------------
// POINT 2 — SIGNALEMENTS PROTECTION MINEURS (Partie C.8)
// --------------------------------------------------------------------

model SignalementMineur {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  eleveId         String?
  eleve           Eleve?   @relation(fields: [eleveId], references: [id])
  type            String   // harcelement/maltraitance/fgm/radicalisation/abus/lautre
  description     String
  gravite         String   // information/preoccupant/grave/urgent
  source          String   // enseignant/parent/eleve/tiers/anonyme
  dateSignalement DateTime @default(now())
  dateFaits       DateTime?
  lieuFaits       String?
  declareParId    String?
  signalantAnonyme Boolean @default(false)
  statut          String   @default("recu") // recu/en_cours/transmis_externe/traite/classe_sans_suite
  confidentialiteNiveau String @default("restreint") // public/equipe_dir/restreint/confidentiel
  partenairesExternesIds String? // JSON array
  transfertCrip   Boolean  @default(false)
  dateTransfertCrip DateTime?
  mesuresProvisoires String?

  mesures         MesureProtection[]
  suivis          SuiviSignalement[]
}

model PartenaireExterne {
  id              String   @id @default(cuid())
  type            String   // crip/assistant_social/police/justice/association
  nom             String
  contact         String
  email           String?
  adresse         String?
  actif           Boolean  @default(true)
}

model MesureProtection {
  id              String   @id @default(cuid())
  signalementId   String
  signalement     SignalementMineur @relation(fields: [signalementId], references: [id])
  type            String   // signalement_au_parquet/accompagnement_psychologique/mesure_de_securite/reorientation/saisine_ase
  description     String
  decideePar      String
  dateDecision    DateTime @default(now())
  dateFin         DateTime?
  statut          String   @default("planifiee") // planifiee/en_cours/realisee/annulee
}

model SuiviSignalement {
  id              String   @id @default(cuid())
  signalementId   String
  signalement     SignalementMineur @relation(fields: [signalementId], references: [id])
  note            String
  auteurId        String?
  date            DateTime @default(now())
}

// --------------------------------------------------------------------
// POINT 3 — HABILITATION PÉNALE / VÉRIFICATION ANTÉCÉDENTS (Partie C.8)
// --------------------------------------------------------------------

model VerificationAntecedents {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  personnelId     String
  personnel       Personnel @relation(fields: [personnelId], references: [id])
  type            String   // casier_judiciaire/extrait_casier/declaration_honneur/attestation_aptitude
  referenceDossier String?
  statut          String   @default("demandee") // demandee/en_cours/obtenue/refusee
  dateDemande     DateTime @default(now())
  dateObtention   DateTime?
  dateExpiration  DateTime?
  fichierUrl      String?
  valideParId     String?
}

model HabilitationPenale {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  personnelId     String
  personnel       Personnel @relation(fields: [personnelId], references: [id])
  numeroHabilitation String?
  dateDelivrance  DateTime?
  dateExpiration  DateTime?
  autoriteEmettrice String?
  statut          String   @default("non_verifiee") // non_verifiee/validee/expiree/a_renouveler
}

// --------------------------------------------------------------------
// POINT 4 — BULLETINS DE PAIE (Partie B RH)
// --------------------------------------------------------------------

model BulletinPaie {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  personnelId     String
  personnel       Personnel @relation(fields: [personnelId], references: [id])
  periode         String   // "2026-08"
  salaireBrut     Float
  salaireNet      Float
  cotisationsTotales Float
  retenuesTotales Float
  primesTotales   Float
  netAPayer       Float
  devise          String
  statut          String   @default("brouillon") // brouillon/valide/paye
  dateEdition     DateTime @default(now())
  dateValidation  DateTime?
  datePaiement    DateTime?
  valideParId     String?
  pdfUrl          String?

  lignes          LigneBulletinPaie[]
  cotisations     CotisationSociale[]
  variables       VariablePaie[]

  @@unique([personnelId, periode])
}

model LigneBulletinPaie {
  id              String   @id @default(cuid())
  bulletinId      String
  bulletin        BulletinPaie @relation(fields: [bulletinId], references: [id])
  type            String   // salaire_base/prime/indemnite/retenue/heures_sup/avantage_nature
  libelle         String
  montant         Float
  sens            String   // plus/moins
  quantite        Float?
  taux            Float?
}

model CotisationSociale {
  id              String   @id @default(cuid())
  bulletinId      String
  bulletin        BulletinPaie @relation(fields: [bulletinId], references: [id])
  libelle         String   // IPM/RC/PCF/Assurance_maladie
  assiette       Float
  tauxEmployeur   Float
  tauxSalarie     Float
  partEmployeur   Float
  partSalarie     Float
}

model VariablePaie {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  personnelId     String
  personnel       Personnel @relation(fields: [personnelId], references: [id])
  periode         String
  type            String   // prime/indemnite/avantage/heure_sup
  libelle         String
  montant         Float
  dateAttribution DateTime @default(now())
  attribueParId   String?
}

// --------------------------------------------------------------------
// POINT 5 — RECRUTEMENT (Partie B RH)
// --------------------------------------------------------------------

model OffreEmploi {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  poste           String
  description     String
  profilRecherche String
  typeContrat     String   // CDI/CDD/Stage/Vacataire
  dateOuverture   DateTime @default(now())
  dateCloture     DateTime?
  statut          String   @default("ouverte") // ouverte/fermee/pourvue
  lieu            String?

  candidatures    Candidature[]
}

model Candidature {
  id              String   @id @default(cuid())
  offreId         String
  offre           OffreEmploi @relation(fields: [offreId], references: [id])
  nom             String
  prenom          String
  email           String
  telephone       String?
  cvUrl           String?
  lettreMotivation String?
  source          String   // spontanee/offre/interne/recommandation
  dateReception   DateTime @default(now())
  statut          String   @default("recue") // recue/presel/entretien/retenu/refuse
  etapeActuelle   String?

  etapes          EtapeRecrutement[]
  entretiens      EntretienRecrutement[]
}

model EtapeRecrutement {
  id              String   @id @default(cuid())
  candidatureId   String
  candidature     Candidature @relation(fields: [candidatureId], references: [id])
  etape           String   // tri_cv/entretien_rh/entretien_direction/essai/decision
  statut          String   // en_cours/valide/refuse
  date            DateTime @default(now())
  note            String?
  decideurId      String?
}

model EntretienRecrutement {
  id              String   @id @default(cuid())
  candidatureId   String
  candidature     Candidature @relation(fields: [candidatureId], references: [id])
  date            DateTime
  lieu            String
  type            String   // physique/video/telephone
  intervieweurs   String?  // JSON
  compteRendu     String?
  note            Int?
  statut          String   @default("planifie") // planifie/realise/annule
}

// --------------------------------------------------------------------
// POINT 6 — STAGES & CONVENTIONS (Partie B RH/Pédagogique)
// --------------------------------------------------------------------

model Stage {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  eleveId         String
  eleve           Eleve    @relation(fields: [eleveId], references: [id])
  entreprise      String
  poste           String
  dateDebut       DateTime
  dateFin         DateTime
  tuteurEntreprise String?
  encadrantEcoleId String?
  objectifs       String?
  evaluation      String?
  statut          String   @default("planifie") // planifie/en_cours/termine/annule
  conventionUrl   String?
}

model ConventionStage {
  id              String   @id @default(cuid())
  stageId         String
  stage           Stage    @relation(fields: [stageId], references: [id])
  numeroConvention String?
  dateSignature    DateTime?
  signeParEleve    Boolean @default(false)
  signeParEcole     Boolean @default(false)
  signeParEntreprise Boolean @default(false)
  fichierUrl       String?
  statut          String   @default("brouillon") // brouillon/valide/signe
}

// --------------------------------------------------------------------
// POINT 7 — SOLDES DE CONGÉS PAYÉS (Partie B RH)
// --------------------------------------------------------------------

model SoldeConge {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  personnelId     String
  personnel       Personnel @relation(fields: [personnelId], references: [id])
  annee           String
  droitsAcquis    Float    @default(0)
  joursPris       Float    @default(0)
  joursRestants   Float    @default(0)
  reliquatAnterieur Float  @default(0)
  derniereMaj      DateTime @default(now())

  @@unique([personnelId, annee])
}

// --------------------------------------------------------------------
// POINT 8 — ADMISSIONS / PRÉ-INSCRIPTIONS (Partie B Élèves)
// --------------------------------------------------------------------

model CandidatureAdmission {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  niveauId        String?
  niveau          Niveau?  @relation(fields: [niveauId], references: [id])
  nom             String
  prenom          String
  dateNaissance   DateTime
  lieuNaissance   String?
  sexe            String?
  email           String
  telephone       String?
  parentNom       String?
  parentTelephone String?
  statut          String   @default("soumis") // soumis/test/entretien/admis/refuse/inscrit
  dateSoumission  DateTime @default(now())
  dateDecision    DateTime?
  parcoursAnterieur String?
  etablissementOrigine String?
  dossierComplet  Boolean  @default(false)
  notesEntretien  String?

  etapes          EtapeAdmission[]
  tests           TestAdmission[]
}

model EtapeAdmission {
  id              String   @id @default(cuid())
  candidatureId   String
  candidature     CandidatureAdmission @relation(fields: [candidatureId], references: [id])
  etape           String   // depot_dossier/test_admission/entretien/decision/finalisation
  statut          String   @default("en_attente") // en_attente/valide/refuse
  date            DateTime @default(now())
  valideParId     String?
  commentaire     String?
}

model TestAdmission {
  id              String   @id @default(cuid())
  candidatureId   String
  candidature     CandidatureAdmission @relation(fields: [candidatureId], references: [id])
  matiere         String
  date            DateTime
  note            Float?
  sur             Float    @default(20)
  appreciation    String?
  evalueParId     String?
}

// --------------------------------------------------------------------
// POINT 9 — EMPLOI DU TEMPS RÉCURRENT (Partie B Pédagogique)
// --------------------------------------------------------------------

model EmploiTemps {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  classeId        String?
  classe          Classe?  @relation(fields: [classeId], references: [id])
  enseignantId    String?
  matiereId       String?
  salleId         String?
  jour            String   // lundi/mardi/...
  heureDebut      String   // "08:00"
  heureFin        String   // "10:00"
  recurrenceRule  String?  // iCal RRULE, ex: "FREQ=WEEKLY;UNTIL=20260630"
  dateDebut       DateTime
  dateFin         DateTime?
  statut          String   @default("actif") // actif/suspendu/termine
  creeParId       String?
  dateCreation    DateTime @default(now())

  seancesGenereesIds String? // JSON
}

model CreneauHebdo {
  id              String   @id @default(cuid())
  emploiTempsId   String
  emploiTemps     EmploiTemps @relation(fields: [emploiTempsId], references: [id])
  jourSemaine     Int      // 0=dim, 1=lun, ..., 6=sam
  heureDebut      String
  heureFin        String
  salleId         String?
  matiereId       String?
  enseignantId    String?
  classeId        String?
  type            String   @default("cours") // cours/etude/recreation/pause_midi
}

// --------------------------------------------------------------------
// POINT 10 — DEVOIRS & RENDUS (Partie B Pédagogique)
// --------------------------------------------------------------------

model Devoir {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  classeId        String
  classe          Classe   @relation(fields: [classeId], references: [id])
  matiereId       String?
  enseignantId    String
  intitule        String
  description     String?
  dateAssignation DateTime @default(now())
  dateRendu       DateTime
  sur             Float    @default(20)
  coefficient     Float    @default(1)
  type            String   @default("devoir") // devoir/dm/projet/expose
  pieceJointeUrl  String?
  statut          String   @default("assigne") // assigne/ramasse/corrige/rendu
  cahierTexteId   String?

  rendus          RenduDevoir[]
}

model RenduDevoir {
  id              String   @id @default(cuid())
  devoirId        String
  devoir          Devoir    @relation(fields: [devoirId], references: [id])
  eleveId         String
  eleve           Eleve    @relation(fields: [eleveId], references: [id])
  dateRendu       DateTime @default(now())
  contenuUrl      String?
  commentaireEleve String?
  note            Float?
  appreciation    String?
  corrigeParId    String?
  dateCorrection  DateTime?
  statut          String   @default("rendu") // rendu/en_correction/corrige/absent
}

// --------------------------------------------------------------------
// POINT 11 — CAHIER DE TEXTES (Partie B Pédagogique)
// --------------------------------------------------------------------

model CahierTexte {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  classeId        String
  classe          Classe   @relation(fields: [classeId], references: [id])
  matiereId       String?
  enseignantId    String
  periodeId       String?
  statut          String   @default("actif")
  dateCreation    DateTime @default(now())

  entrees         EntreeCahierTexte[]
}

model EntreeCahierTexte {
  id              String   @id @default(cuid())
  cahierTexteId   String
  cahierTexte     CahierTexte @relation(fields: [cahierTexteId], references: [id])
  seanceId        String?
  dateCours       DateTime
  contenu         String   // ce qui a été fait en cours
  travailAFaire   String?  // devoirs pour la prochaine séance
  ressourcesUrl   String?
  statut          String   @default("brouillon") // brouillon/publie/valide
  valideParId     String?
  dateValidation  DateTime?
}

// --------------------------------------------------------------------
// POINT 12 — CONSEILS DE CLASSE (Partie B Pédagogique)
// --------------------------------------------------------------------

model ConseilClasse {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  classeId        String
  classe          Classe   @relation(fields: [classeId], references: [id])
  periodeId       String
  date            DateTime
  salle           String?
  statut          String   @default("planifie") // planifie/en_cours/termine/annule
  compteRendu     String?
  presidentId     String?

  membres         MembreConseil[]
  deliberations   DeliberationConseil[]
}

model MembreConseil {
  id              String   @id @default(cuid())
  conseilId       String
  conseil         ConseilClasse @relation(fields: [conseilId], references: [id])
  utilisateurId   String
  role             String   // president/enseignant/parent_delegue/eleve_delegue/invite
  present          Boolean @default(false)
  observation     String?
}

model DeliberationConseil {
  id              String   @id @default(cuid())
  conseilId       String
  conseil         ConseilClasse @relation(fields: [conseilId], references: [id])
  eleveId         String
  eleve           Eleve    @relation(fields: [eleveId], references: [id])
  decision        String   // passage/redoublement/exclusion_orientation/doublement
  mention         String?  // encouragements/felicitations/tableau_honneur
  appreciationGenerale String?
  objectifSuivant String?
  avis            String?

  votes           VoteConseil[]
}

model VoteConseil {
  id              String   @id @default(cuid())
  deliberationId  String
  deliberation    DeliberationConseil @relation(fields: [deliberationId], references: [id])
  membreId        String
  membre          MembreConseil @relation(fields: [membreId], references: [id])
  vote            String   // pour/contre/abstention
  date            DateTime @default(now())
}

// --------------------------------------------------------------------
// POINT 13 — DISPENSES (Partie B Pédagogique)
// --------------------------------------------------------------------

model Dispense {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  eleveId         String
  eleve           Eleve    @relation(fields: [eleveId], references: [id])
  matiereId       String?
  motif           String   // medical/sportif/religieux/autre
  description     String
  dateDebut       DateTime
  dateFin         DateTime?
  justificatifUrl String?
  statut          String   @default("demandee") // demandee/validee/refusee
  valideParId     String?
  dateValidation  DateTime?
}

// --------------------------------------------------------------------
// POINT 14 — WORKFLOW JUSTIFICATION D'ABSENCE (Partie B Présences)
// --------------------------------------------------------------------

model JustificationAbsence {
  id              String   @id @default(cuid())
  ecoleId         String?
  ecole           Ecole?   @relation(fields: [ecoleId], references: [id])
  eleveId         String
  eleve           Eleve    @relation(fields: [eleveId], references: [id])
  presenceId      String?
  dateAbsence     DateTime
  dureeHeures     Float?
  motif           String   // maladie/familial/rendez_vous_medical/ceremonie/transport/autre
  description     String?
  justificatifUrl String?
  statut          String   @default("soumis") // soumis/valide/rejete
  soumisParId     String?
  valideParId     String?
  dateSoumission   DateTime @default(now())
  dateValidation  DateTime?
  commentaireValidation String?
}

// --------------------------------------------------------------------
// POINT 15 — BUDGETS PRÉVISIONNELS (Partie B Finances)
// --------------------------------------------------------------------

model Budget {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  libelle         String
  dateDebut       DateTime
  dateFin         DateTime
  statut          String   @default("brouillon") // brouillon/valide/cloture
  valideParId     String?
  dateValidation  DateTime?

  lignes          LigneBudget[]
}

model LigneBudget {
  id              String   @id @default(cuid())
  budgetId        String
  budget          Budget   @relation(fields: [budgetId], references: [id])
  categorie       String   // recettes/depenses
  sousCategorie   String   // frais_scolarite/subventions/fonctionnement/salaries/equipement
  libelle         String
  montantPrevu    Float
  montantRealise  Float    @default(0)
  devise          String
  pourcentageRealise Float  @default(0)
  dateDerniereMaj  DateTime @default(now())
}

// --------------------------------------------------------------------
// POINT 16 — COMPTABILITÉ GÉNÉRALE (Partie B Finances)
// --------------------------------------------------------------------

model CompteComptable {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  numero          String
  libelle         String
  type             String   // actif/passif/produit/charge
  parent          String?
  solde           Float    @default(0)
  devise          String
  actif           Boolean  @default(true)

  lignesEcriture  LigneEcriture[]
}

model JournalComptable {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  code            String   // VE/ACH/VTE/BQ/OD
  libelle         String
  type            String   // achat/vente/banque/operations_diverses

  ecritures       EcritureComptable[]
}

model EcritureComptable {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  journalId       String
  journal         JournalComptable @relation(fields: [journalId], references: [id])
  date            DateTime @default(now())
  numeroPiece     String?
  libelle         String
  statut          String   @default("brouillon") // brouiller/valide/annule
  valideParId     String?
  dateValidation  DateTime?
  pieceJustificativeUrl String?

  lignes          LigneEcriture[]
}

model LigneEcriture {
  id              String   @id @default(cuid())
  ecritureId      String
  ecriture        EcritureComptable @relation(fields: [ecritureId], references: [id])
  compteId        String
  compte          CompteComptable @relation(fields: [compteId], references: [id])
  libelle         String
  debit           Float    @default(0)
  credit          Float    @default(0)
}

// --------------------------------------------------------------------
// POINT 17 — FOURNISSEURS & COMMANDES (Partie B Finances)
// --------------------------------------------------------------------

model Fournisseur {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  nom             String
  type            String   // fournisseur_prestataire/sous_traitant
  contact         String?
  email           String?
  telephone       String?
  adresse         String?
  rib             String?
  siret           String?
  statut          String   @default("actif") // actif/bloque/blackliste
  dateCreation    DateTime @default(now())

  commandes       CommandeFournisseur[]
  factures        FactureFournisseur[]
}

model CommandeFournisseur {
  id              String   @id @default(cuid())
  ecoleId         String
  ecole           Ecole    @relation(fields: [ecoleId], references: [id])
  fournisseurId   String
  fournisseur     Fournisseur @relation(fields: [fournisseurId], references: [id])
